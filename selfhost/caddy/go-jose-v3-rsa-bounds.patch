+++ b/jwk_bounds_test.go
@@ -0,0 +1,49 @@
+package jose
+
+import (
+	"crypto/rand"
+	"crypto/rsa"
+	"encoding/json"
+	"math/big"
+	"strings"
+	"testing"
+)
+
+func TestRSAModulusBound(t *testing.T) {
+	n := new(big.Int).Lsh(big.NewInt(1), uint(MaxRSAModulusBits))
+	raw := rawJSONWebKey{Kty: "RSA", N: newBuffer(n.Bytes()), E: newBuffer([]byte{1, 0, 1})}
+	if _, err := raw.rsaPublicKey(); err == nil || !strings.Contains(err.Error(), "modulus too large") {
+		t.Fatalf("oversized public modulus accepted: %v", err)
+	}
+	raw.D, raw.P, raw.Q = newBuffer([]byte{1}), newBuffer([]byte{1}), newBuffer([]byte{1})
+	if _, err := raw.rsaPrivateKey(); err == nil || !strings.Contains(err.Error(), "modulus too large") {
+		t.Fatalf("oversized private modulus accepted: %v", err)
+	}
+}
+
+func TestRSAPrivateKeyFactorsMustMatchModulus(t *testing.T) {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	other, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	good, err := json.Marshal(JSONWebKey{Key: key})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var parsed JSONWebKey
+	if err := json.Unmarshal(good, &parsed); err != nil {
+		t.Fatalf("valid key rejected: %v", err)
+	}
+	raw := rawJSONWebKey{}
+	if err := json.Unmarshal(good, &raw); err != nil {
+		t.Fatal(err)
+	}
+	raw.Q = newBuffer(other.Primes[1].Bytes())
+	if _, err := raw.rsaPrivateKey(); err == nil || !strings.Contains(err.Error(), "p * q != n") {
+		t.Fatalf("mismatched factors accepted: %v", err)
+	}
+}
