# Fluent Bit 5.1.3 (monitoring overlay) with Debian's security build of libbrotli1.
# The pinned vendor image ships libbrotli1 1.1.0-2+b7 (CVE-2026-111497, CRITICAL; trivy gate in
# scripts/publish-images.sh); 5.1.5 adds libcurl findings. The image is distroless, so the fixed
# trixie-security package is unpacked in a Debian 13 stage and its libraries and dpkg status record
# replace the old ones. Drop this image once a Fluent Bit release carries libbrotli1 1.1.0-2+deb13u1.
FROM debian:13-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4 AS brotli
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /pkg
RUN apt-get update && apt-get download libbrotli1=1.1.0-2+deb13u1 && \
    dpkg-deb -x libbrotli1_1.1.0-2+deb13u1_amd64.deb /out && \
    mkdir -p /out/var/lib/dpkg/status.d && \
    dpkg-deb -f libbrotli1_1.1.0-2+deb13u1_amd64.deb > /out/var/lib/dpkg/status.d/libbrotli1 && \
    rm -rf /var/lib/apt/lists/*

FROM fluent/fluent-bit:5.1.3@sha256:c5542543523c9678398dd78d927c05e8425ec15b038f226b67b3b019b1a70845
COPY --from=brotli /out/usr/lib/x86_64-linux-gnu/ /usr/lib/x86_64-linux-gnu/
COPY --from=brotli /out/usr/share/doc/libbrotli1/ /usr/share/doc/libbrotli1/
COPY --from=brotli /out/var/lib/dpkg/status.d/libbrotli1 /var/lib/dpkg/status.d/libbrotli1
