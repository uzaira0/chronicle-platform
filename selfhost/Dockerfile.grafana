# Install the pinned datasource at build time; cold starts need only registry egress.
FROM alpine:3.23@sha256:5b10f432ef3da1b8d4c7eb6c487f2f5a8f096bc91145e68878dd4a5019afde11 AS plugin
SHELL ["/bin/ash", "-o", "pipefail", "-c"]
# Fetched and verified in one step (a failed checksum fails the build before unzip runs).
RUN wget -q -O /plugin.zip https://grafana.com/api/plugins/victoriametrics-logs-datasource/versions/0.33.1/download && \
    echo "73e7ce379ae9a9ce6fdb978e5d6d43f67029b4c3e4d970f1ca8f7f4617f331c5  /plugin.zip" | sha256sum -c - && \
    unzip -q /plugin.zip -d /plugins

FROM grafana/grafana:13.2.4@sha256:dbbc38ea21103cefb50396340cd88afec779c7e070b0a7bf5a75b4ce46651d3f
COPY --from=plugin --chown=472:0 /plugins /opt/chronicle-plugins
USER 472:0
HEALTHCHECK --interval=30s --timeout=8s --retries=8 CMD curl -fsS -o /dev/null http://127.0.0.1:3000/api/health || exit 1
