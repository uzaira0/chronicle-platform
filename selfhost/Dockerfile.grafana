# Install the pinned datasource at build time; cold starts need only registry egress.
FROM alpine:3.24@sha256:3f4d6b32e26703c6082839234f43769d5046b3ac7c910033911d1e71d8cd630a AS plugin
SHELL ["/bin/ash", "-o", "pipefail", "-c"]
# The plugin's GitHub release tag; grafana.com serves the same version without the v. Renovate proposes a new
# tag (custom manager in renovate.json); the zip's sha256 is refreshed by hand with it (label manual-digests),
# and until it is, sha256sum -c fails the build.
# renovate: datasource=github-releases depName=VictoriaMetrics/victorialogs-datasource
ARG VL_PLUGIN_TAG=v0.33.1
ARG VL_PLUGIN_SHA256=73e7ce379ae9a9ce6fdb978e5d6d43f67029b4c3e4d970f1ca8f7f4617f331c5
# Fetched and verified in one step (a failed checksum fails the build before unzip runs).
RUN wget -q -O /plugin.zip "https://grafana.com/api/plugins/victoriametrics-logs-datasource/versions/${VL_PLUGIN_TAG#v}/download" && \
    echo "${VL_PLUGIN_SHA256}  /plugin.zip" | sha256sum -c - && \
    unzip -q /plugin.zip -d /plugins && \
    # The release image is linux/amd64 (scripts/publish-images.sh); the plugin zip carries backends for
    # every platform. Keep only the one Grafana loads here, so the image ships no unused Go binaries.
    find /plugins/victoriametrics-logs-datasource -maxdepth 1 -type f -name 'victoriametrics_logs_backend_plugin_*' \
      ! -name "victoriametrics_logs_backend_plugin_linux_$(uname -m | sed -e s/x86_64/amd64/ -e s/aarch64/arm64/)" -delete && \
    test "$(find /plugins/victoriametrics-logs-datasource -maxdepth 1 -name 'victoriametrics_logs_backend_plugin_*' | wc -l)" -eq 1

# The 13.2.5 server binary links go-jose v4.1.4 (HIGH advisory fixed in 4.1.6; trivy gate in
# scripts/publish-images.sh) and is built with Go 1.26.10. Rebuild the same tag with Grafana's release flags
# (Makefile build-go: CGO off, -trimpath, -buildvcs=false, version ldflags; buildstamp from the release binary)
# with Go 1.27.4 (GO-2026-6859, the net/http MaxBytesReader header race, is fixed there), go-jose raised to 4.1.8
# and golang.org/x/net raised to 0.62.0 (CVE-2026-78661, x/net/html tokenizer denial of service; 13.2.5 links
# 0.60.0). 13.2.5 already requires kin-openapi 0.151.0 and brotli 1.2.7.
# Drop this stage once a Grafana release image links go-jose 4.1.6 and x/net 0.62.0 or newer.
FROM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS server
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# The source tag moves with the grafana/grafana image below (renovate.json groups grafana/**). The tag's commit
# (git ls-remote) and the release binary's buildstamp are refreshed by hand with it (label manual-digests).
# renovate: datasource=github-releases depName=grafana/grafana
ARG GRAFANA_SOURCE_TAG=v13.2.5
ARG GRAFANA_SOURCE_COMMIT=ce471d869a4810cd83c987dd3521c4b67689dbb6
ARG GRAFANA_BUILDSTAMP=1793032020
# renovate: datasource=go depName=github.com/go-jose/go-jose/v4
ARG GO_JOSE_V4_VERSION=v4.1.8
# renovate: datasource=go depName=golang.org/x/net
ARG GOLANG_X_NET_VERSION=v0.62.0
RUN git clone --quiet --depth 1 --branch "${GRAFANA_SOURCE_TAG}" https://github.com/grafana/grafana /src && \
    test "$(git -C /src rev-parse HEAD)" = "${GRAFANA_SOURCE_COMMIT}"
WORKDIR /src
RUN go work edit -replace="github.com/go-jose/go-jose/v4=github.com/go-jose/go-jose/v4@${GO_JOSE_V4_VERSION}" && \
    go work edit -replace="golang.org/x/net=golang.org/x/net@${GOLANG_X_NET_VERSION}" && \
    CGO_ENABLED=0 GOTOOLCHAIN=local go build -buildvcs=false -trimpath \
        -ldflags "-X main.version=${GRAFANA_SOURCE_TAG#v} -X main.commit=${GRAFANA_SOURCE_COMMIT} -X main.buildBranch=HEAD -X main.buildstamp=${GRAFANA_BUILDSTAMP}" \
        -o /out/grafana ./pkg/cmd/grafana && \
    go version -m /out/grafana > /out/buildinfo && \
    grep -q "$(printf 'go-jose/v4\t%s' "${GO_JOSE_V4_VERSION}")" /out/buildinfo && \
    grep -q "$(printf 'golang.org/x/net\t%s' "${GOLANG_X_NET_VERSION}")" /out/buildinfo && \
    grep -q 'getkin/kin-openapi	v0.151.0' /out/buildinfo && \
    grep -q 'andybalholm/brotli	v1.2.7' /out/buildinfo

FROM grafana/grafana:13.2.5@sha256:9f7aa1e1e3246aade5792d35a738049f7f32f89cd51d1956cf426a4e86268a84
USER root
# Alpine fixes published after the base digest was cut enter once older than the dependency wait
# (os-packages/apk-install-aged.sh; scripts/os-package-pins.py refreshes the pins).
RUN --mount=type=bind,source=os-packages/apk-install-aged.sh,target=/usr/local/sbin/apk-install-aged.sh \
    sh /usr/local/sbin/apk-install-aged.sh v3.24 \
      --upgrade alpine-release=3.24.4-r0 apk-tools=3.0.9-r0 libapk=3.0.9-r0 tzdata=2026f-r0
# Ship only the bundled datasource Chronicle provisions (prometheus 13.2.4, Go 1.27.3). The other twelve were
# already disabled by GF_PLUGINS_DISABLE_PLUGINS (overlays/monitoring.yml); deleting them drops their Go findings
# instead of waiving them.
RUN find /usr/share/grafana/data/plugins-bundled -mindepth 1 -maxdepth 1 ! -name prometheus -exec rm -rf {} + && \
    test "$(ls /usr/share/grafana/data/plugins-bundled)" = prometheus
COPY --from=server --chown=0:0 /out/grafana /usr/share/grafana/bin/grafana
COPY --from=plugin --chown=472:0 /plugins /opt/chronicle-plugins
USER 472:0
# Same protocol as the server: the monitoring overlay serves HTTPS (GF_SERVER_PROTOCOL, GF_SERVER_CERT_FILE) and
# probes it with this certificate; an image run without that overlay serves and is probed over HTTP.
HEALTHCHECK --interval=30s --timeout=8s --retries=8 \
    CMD ["/bin/sh", "-c", "if [ \"${GF_SERVER_PROTOCOL:-http}\" = https ]; then exec curl -fsS -o /dev/null --cacert \"$GF_SERVER_CERT_FILE\" https://127.0.0.1:3000/api/health; fi; exec curl -fsS -o /dev/null http://127.0.0.1:3000/api/health"]
