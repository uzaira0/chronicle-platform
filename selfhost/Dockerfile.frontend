# Build-only frontend image for the self-host stack.
#
# docker/Dockerfile.frontend.prod cannot be reused here: it is a *serving* image that
# builds to /app/dist and then runs nginx on :8080 from /usr/share/nginx/html. This bundle
# serves static files from Caddy instead, so it needs the build output published into a
# shared volume rather than a second web server.
#
# This container is a one-shot job: it copies the built bundle into /out (the frontend_build
# volume that Caddy mounts at /srv) and exits. It copies when the release changes, so
# a rebuilt frontend actually reaches Caddy — a named volume is only auto-populated from an
# image when it is empty, which would otherwise silently serve a stale dashboard forever.
#checkov:skip=CKV_DOCKER_2: Build-only image: Dockerfile.caddy copies /dist from it and no Compose service runs it.

FROM oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a AS builder

ARG GIT_SHA=selfhost

SHELL ["/bin/ash", "-o", "pipefail", "-c"]

WORKDIR /app

COPY chronicle-web/package.json chronicle-web/bun.lock chronicle-web/bunfig.toml ./
COPY chronicle-web/vendor ./vendor

RUN bun install --frozen-lockfile --ignore-scripts

COPY chronicle-web/ ./

RUN bun run build

# Source maps would expose readable application source to anyone who loads the dashboard.
RUN find /app/dist -name '*.map' -delete 2>/dev/null; true
RUN echo "{\"version\":\"${GIT_SHA}\",\"buildTime\":\"$(date -Iseconds)\"}" > /app/dist/version.json

FROM alpine:3.24@sha256:3f4d6b32e26703c6082839234f43769d5046b3ac7c910033911d1e71d8cd630a

ARG SOURCE_REF=unknown

# Alpine fixes enter only once older than the dependency wait (selfhost/os-packages/apk-install-aged.sh;
# scripts/os-package-pins.py refreshes the pins).
RUN --mount=type=bind,source=selfhost/os-packages/apk-install-aged.sh,target=/usr/local/sbin/apk-install-aged.sh \
    sh /usr/local/sbin/apk-install-aged.sh v3.24 && \
    mkdir -p /usr/share/doc/chronicle

COPY LICENSE /usr/share/doc/chronicle/LICENSE
COPY chronicle-web/LICENSE /usr/share/doc/chronicle/LICENSE-chronicle-web
RUN printf 'Corresponding Chronicle source: https://github.com/uzaira0/methodic/tree/%s\n' "$SOURCE_REF" \
    > /usr/share/doc/chronicle/SOURCE-CODE
LABEL org.opencontainers.image.source="https://github.com/uzaira0/methodic" \
      org.opencontainers.image.version="${SOURCE_REF}"

COPY --from=builder /app/dist /dist

# Build artifact consumed by Dockerfile.caddy; the serving tree is immutable.
USER 65534:65534
CMD ["true"]
