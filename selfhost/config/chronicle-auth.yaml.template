# Rendered by ../backend-entrypoint.sh at container start.
#
# The self-host dashboard signs in with the shared dashboard password; no identity provider
# is configured, so the OIDC entries below are fixed to disabled.
domain: "${DOMAIN}"
clientId: "chronicle-selfhost"
clientSecret: "${JWT_SECRET}"
configurations:
  - name: "local-testing"
    issuer: "https://localhost/"
    audience: "dummy-client-id"
    secret: "${JWT_SECRET}"
    previousSecret: "${JWT_SECRET_PREVIOUS}"
    previousSecretExpiresAt: ${JWT_SECRET_PREVIOUS_EXPIRES_AT}
    base64EncodedSecret: false
    signingAlgorithm: "HS256"
    testingTokenIssuer: true
  - name: "oidc-broker"
    issuer: ""
    audience: ""
    jwkSetUri: ""
    secret: ""
    base64EncodedSecret: false
    signingAlgorithm: "RS256"
    testingTokenIssuer: false
testingLoginEnabled: ${TESTING_LOGIN_ENABLED}
allowProductionTestingLogin: false
# The backend login endpoint verifies the dashboard password against this bcrypt hash and
# mints a cookie-backed dashboard session; an empty value fails closed.
dashboardPasswordHash: "${DASHBOARD_PASSWORD_HASH}"
oidc:
  enabled: false
  providerLabel: ""
  publicBaseUrl: ""
  issuer: ""
  authorizationUri: ""
  tokenUri: ""
  jwkSetUri: ""
  clientId: ""
  clientSecret: ""
  identityProviderHint: ""
  scopes:
    - openid
    - email
    - profile
  redirectPath: "/chronicle/v3/auth/oidc/callback"
  postLoginRedirectUri: "/chronicle"
  cookieTokenClaim: ""
managementApiUrl: "localhost"
users:
  - user_id: "local-admin"
    email: "admin@chronicle.local"
    email_verified: true
    app_metadata:
      roles:
        - AuthenticatedUser
        - admin
