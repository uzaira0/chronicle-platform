max-threads: 500
context:
  descriptor: src/main/webapp/WEB-INF/web.xml
  resource-base: src/main/webapp
  path: /
  parent-loader-priority: true
web-endpoint:
  http-port: 40320
  # Plain HTTP serves only the in-container healthcheck; peers use 8443.
  http-host: 127.0.0.1
  https-port: 8443
  use-ssl: true
  require-ssl: false
  require-client-auth: false
  want-client-auth: false
  certificate-alias: rhizomessl
keymanager-password: ""
keystore:
  path: backend.p12
  password: ""
truststore:
  path: backend.p12
  password: ""
gzip:
  enabled: true
security-enabled: true
