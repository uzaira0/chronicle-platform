# Split exposure AND this stack terminates TLS.
#
# Mounted by overlays/mode-own-tls-internal.yml, which COMPOSE_FILE in .env selects.
#
#   :443  PUBLIC   — mobile ingest, participant forms, static SPA (HTTPS, your cert)
#   :80   PUBLIC   — redirects to HTTPS
#   :8081 INTERNAL — the above PLUS the researcher dashboard API (HTTPS with the internal
#                    certificate, on your VPN/management interface)
#
# Routes come from caddy/snippets.caddy, identical to every other variant.

import snippets.caddy

{
	auto_https off
	# web has no route off the host (docs/NETWORK-EGRESS.md), so Caddy cannot fetch OCSP responses
	# from your CA. Clients check revocation themselves (CRLs, or OCSP where they still use it); a
	# certificate with the OCSP Must-Staple extension is refused by browsers that enforce it, so do
	# not use one here.
	ocsp_stapling off
	import chronicle_default_log

	# rate_limit ships as a plugin (see Dockerfile.caddy), so its place in the handler
	# chain has to be declared explicitly.
	order rate_limit before basic_auth

	servers {
		# web-forward holds the published ports and starts each connection with a PROXY protocol
		# header naming the client. Caddy takes it only from web-forward's fixed ingress address;
		# a header from anywhere else is ignored (docker-compose.yml, docs/NETWORK-EGRESS.md).
		listener_wrappers {
			proxy_protocol {
				allow {$CHRONICLE_INGRESS_FORWARDER}/32
			}
			tls
		}
		import chronicle_listener_timeouts
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

# ---------------------------------------------------------------------------
# PUBLIC — internet-facing, TLS terminated here.
# ---------------------------------------------------------------------------
https://{$DOMAIN} {
	import chronicle_tls
	import chronicle_common

	route {
		import chronicle_health
		import chronicle_public_entrypoints
		import chronicle_deny_direct
		# Deny rules first: `route` preserves order, so these win over the broad
		# /chronicle/v3/* proxy below.
		import chronicle_deny_auth
		import chronicle_deny_researcher_v3
		import chronicle_strip_researcher_bearer
		import chronicle_mobile
		import chronicle_deny_dashboard_api
		import chronicle_spa
	}
}

http://{$DOMAIN} {
	redir {$CHRONICLE_PUBLIC_BASE_URL}{uri} permanent
}

# ---------------------------------------------------------------------------
# INTERNAL — publish ONLY on a VPN/management interface.
# ---------------------------------------------------------------------------
:8081 {
	# TLS so the dashboard password is never sent in the clear. `./chronicle up` generates
	# this self-signed pair (with the right IP SANs) if it is absent; replace both files
	# to use a real certificate. Browsers warn until the cert is trusted.
	tls /etc/caddy/certs/internal-cert.pem /etc/caddy/certs/internal-key.pem

	import chronicle_common

	route {
		import chronicle_health
		import chronicle_public_entrypoints
		# Allowlist first: everything below is researcher surface.
		import chronicle_dashboard_guard
		import chronicle_deny_direct
		import chronicle_mobile
		import chronicle_dashboard_api
		import chronicle_spa
	}
}

import /etc/caddy/monitoring/*.caddy
