# Upstream: https://github.com/prodrigestivill/docker-postgres-backup-local
# Commit: d00896ab15f6da29e0449390315a36c3bbda5082 (debian.Dockerfile, MIT).
# Build with selfhost/ as context (scripts and the shared dump validator).
# Keep upstream scripts, defaults, scheduler version and Debian hook semantics intact.
FROM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS builder

# go-cron v0.0.11 and its dependencies are fixed by backup-image/go-cron/go.mod and go.sum (a module whose
# only content is the `tool` requirement); -mod=readonly fails the build if they would change.
COPY backup-image/go-cron/go.mod backup-image/go-cron/go.sum /src/go-cron/
WORKDIR /src/go-cron
RUN CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-mod=readonly go build -trimpath \
        -ldflags='-s -w -X main.version=v0.0.11' \
        -o /go/bin/go-cron github.com/prodrigestivill/go-cron
WORKDIR /

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# RHEL run-parts lacks Debian's -a, --reverse and --exit-on-error. Build the
# same debianutils version shipped by the upstream image, statically, so its
# glibc requirement does not depend on the builder's newer Debian release.
# xz-utils only at an exact version older than the dependency wait (os-packages/apt-install-aged.sh).
# The source version follows the upstream image, so renovate.json never proposes it; the age gate dates it
# by snapshot.debian.org's first_seen of the source files. A change refreshes the sha256 with it.
# renovate: datasource=custom.debian-source depName=debianutils
ARG DEBIANUTILS_VERSION=5.23.2
ARG DEBIANUTILS_SHA256=79e524b7526dba2ec5c409d0ee52ebec135815cf5b2907375d444122e0594b69
RUN --mount=type=bind,source=os-packages/apt-install-aged.sh,target=/usr/local/sbin/apt-install-aged.sh \
    sh /usr/local/sbin/apt-install-aged.sh debian 20261112T000000Z \
      --add xz-utils \
      --pin xz-utils=5.4.1-1+deb12u2 \
    && mkdir -p /tmp/debianutils /out \
    && curl --fail --show-error --location --retry 4 --retry-all-errors \
        -o /tmp/debianutils.tar.xz \
        "https://deb.debian.org/debian/pool/main/d/debianutils/debianutils_${DEBIANUTILS_VERSION}.tar.xz" \
    && echo "${DEBIANUTILS_SHA256}  /tmp/debianutils.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/debianutils.tar.xz -C /tmp/debianutils --strip-components=1 \
    && gcc -O2 -static -DHAVE_GETOPT_H -DPACKAGE_VERSION="\"${DEBIANUTILS_VERSION}\"" \
        -o /out/run-parts /tmp/debianutils/run-parts.c

# Must match toolchain-manifest.yaml postgres.image + postgres.index_digest.
FROM percona/percona-distribution-postgresql:18.7.1-1@sha256:25b6ee7e12e0fb6eb57001b6a89023168b03ae33827e834beb69139b3c092ce7

# Package changes need root; the image's default user is postgres (26) below, and overlays/backups.yml
# runs it as the operator's UID.
USER 0
WORKDIR /

# No package is upgraded here: the 18.7.1-1 base (RHEL 9.9 packages) ships each fixed build the 18.6.1-4 base
# needed a pinned upgrade for (Python 3.9, expat, ca-certificates, libxml2), or a newer one. Same in
# Dockerfile.postgres.

# Base packages the backup never runs, removed instead of waived (trivy gate in scripts/publish-images.sh): the RPM
# build macros (go-srpm-macros CVE-2026-56860, qt5-srpm-macros CVE-2026-103653, and the macro packages that need
# them), kernel headers, Red Hat's libpq 13 (CVE-2026-116328; pg_dump and psql load /usr/pgsql-18/lib/libpq.so.5),
# Patroni with its etcd client and the Python 3.12 modules only they used (dnspython CVE-2026-128089), BIND client
# tools, make, binutils, and the compilers and Perl build modules that need those. The backup's own scripts run
# Python 3.9 (python3).
# The base has rpm and microdnf but no dnf. rpm with the exact list refuses when a package that stays needs one
# of them, and fails on a name that is not installed, which is how a new base shows that the list needs another
# look. Same list as Dockerfile.postgres.
RUN rpm -e annobin bind-libs bind-license bind-utils binutils binutils-gold fonts-srpm-macros gcc gcc-c++ \
        gcc-plugin-annobin glibc-devel go-srpm-macros kernel-headers libpq libxcrypt-devel make \
        percona-patroni percona-patroni-etcd perl perl-CPAN perl-ExtUtils-CBuilder perl-ExtUtils-Embed \
        perl-ExtUtils-Miniperl perl-devel python-srpm-macros python3-ydiff python3.12-cffi python3.12-click \
        python3.12-cryptography python3.12-dateutil python3.12-dns python3.12-etcd python3.12-idna \
        python3.12-ply python3.12-prettytable python3.12-psutil python3.12-psycopg2 python3.12-pycparser \
        python3.12-pyyaml python3.12-six python3.12-systemd python3.12-urllib3 python3.12-wcwidth \
        qt5-srpm-macros redhat-rpm-config

# The Python 3.12 runtime (python3.12-pip-wheel CVE-2026-57585) and the package-manager libraries (json-glib
# CVE-2026-120194; sqlite-libs CVE-2026-119373, CVE-2026-119374, CVE-2026-119379, CVE-2026-119586); no rpm,
# microdnf or gpg after this. --nodeps because percona-postgresql18-contrib records libpython3.12 for its three
# PL/Python transform modules. The base has no PL/Python itself (no plpython3.so), so they could never load; they
# go with the runtime, and the build fails if any other PostgreSQL program or library has lost a library (or if
# ldd no longer resolves PostgreSQL's own libpq for any of them, which is what a listing that did not run looks like).
RUN rpm -e --nodeps python3.12 python3.12-libs python3.12-pip-wheel json-glib librhsm sqlite-libs && \
    rm -rf /usr/lib/python3.12 /usr/lib64/python3.12 /usr/pgsql-18/lib/hstore_plpython3.so \
        /usr/pgsql-18/lib/jsonb_plpython3.so /usr/pgsql-18/lib/ltree_plpython3.so && \
    test ! -e /usr/bin/python3.12 && test ! -e /usr/pgsql-18/lib/plpython3.so && \
    for f in /usr/pgsql-18/bin/* /usr/pgsql-18/lib/*.so*; do ldd "$f" >>/tmp/ldd.out 2>/dev/null || true; done && \
    grep -q '/usr/pgsql-18/lib/libpq\.so\.5 ' /tmp/ldd.out && \
    if grep 'not found' /tmp/ldd.out; then exit 1; fi && \
    rm /tmp/ldd.out

# CVE-2026-114406: Red Hat's ca-certificates 2026.2.92 (in the base) drops the AAA Certificate Services root
# that cross-signed the compromised eMudhra intermediates; the blocklist also distrusts the 16 intermediates
# themselves (tests/container/selfhost-backup.yaml), so a store that still chains them elsewhere cannot use them.
COPY backup-image/emudhra-distrusted-2026-10.pem /etc/pki/ca-trust/source/blocklist/
RUN update-ca-trust extract

# No setuid or setgid program: the base ships su, mount, umount, newgrp, chage, gpasswd, write, utempter,
# unix_chkpwd and pam_timestamp_check, none of which a backup run uses (scripts/check-image-policy.py).
RUN find / -xdev -type f -perm /6000 -exec chmod a-s {} + && test -z "$(find / -xdev -type f -perm /6000)"

# The backup's scripts need the base's Python 3.9 and flock; fail the build if a base stops shipping either.
RUN python3 -c 'import sys; assert sys.version_info >= (3, 9)' && command -v flock

COPY --from=builder /go/bin/go-cron /usr/local/bin/go-cron
COPY --from=builder /out/run-parts /usr/local/bin/run-parts
COPY --from=builder /tmp/debianutils/debian/copyright /usr/share/doc/debianutils/copyright
COPY --from=builder /usr/share/common-licenses/GPL-2 /usr/share/common-licenses/GPL-2
COPY --from=builder /go/pkg/mod/github.com/prodrigestivill/go-cron@v0.0.11/LICENSE /usr/share/doc/go-cron/LICENSE
COPY backup-image/LICENSE /usr/share/doc/postgres-backup-local/LICENSE

# "**None**" is the upstream scripts' unset marker, not a credential; real values arrive at run time as files.
# hadolint ignore=DL3064
ENV POSTGRES_DB="**None**" \
    POSTGRES_DB_FILE="**None**" \
    POSTGRES_HOST="**None**" \
    POSTGRES_PORT=5432 \
    POSTGRES_USER="**None**" \
    POSTGRES_USER_FILE="**None**" \
    POSTGRES_PASSWORD="**None**" \
    POSTGRES_PASSWORD_FILE="**None**" \
    POSTGRES_PASSFILE_STORE="**None**" \
    POSTGRES_EXTRA_OPTS="-Z1" \
    POSTGRES_CLUSTER="FALSE" \
    SCHEDULE="@daily" \
    VALIDATE_ON_START="TRUE" \
    BACKUP_ON_START="FALSE" \
    BACKUP_SUCCESS_MARKER="/tmp/startup-backup-complete" \
    BACKUP_DIR="/backups" \
    BACKUP_SUFFIX=".sql.gz" \
    BACKUP_LATEST_TYPE="symlink" \
    BACKUP_KEEP_DAYS=7 \
    BACKUP_KEEP_WEEKS=4 \
    BACKUP_KEEP_MONTHS=6 \
    BACKUP_KEEP_MINS=1440 \
    HEALTHCHECK_PORT=8080 \
    WEBHOOK_URL="**None**" \
    WEBHOOK_ERROR_URL="**None**" \
    WEBHOOK_PRE_BACKUP_URL="**None**" \
    WEBHOOK_POST_BACKUP_URL="**None**" \
    WEBHOOK_EXTRA_ARGS=""

COPY backup-image/hooks /hooks
COPY backup-image/backup.sh backup-image/env.sh backup-image/init.sh /
COPY backup-image/selfcheck.sh backup-image/selfcheck.py init-tde.sh /
COPY chronicle_ops /chronicle_ops
ENV PYTHONDONTWRITEBYTECODE=1
RUN chmod 0755 /selfcheck.sh /selfcheck.py

VOLUME /backups

# Never root by default: overlays/backups.yml sets the operator's UID, and a bare `docker run` gets postgres.
USER 26:26

ENTRYPOINT []
CMD ["/init.sh"]

HEALTHCHECK --interval=5m --timeout=3s \
    CMD ["/bin/sh", "-c", "python3 /selfcheck.py health && exec curl -fsS -o /dev/null \"http://127.0.0.1:${HEALTHCHECK_PORT}/\""]
