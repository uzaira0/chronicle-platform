  ops_python owner-check || die "shutdown must run from the active selfhost directory"
  ops_python reconcile stop || die "could not pause periodic reconciliation before shutdown; run ./chronicle doctor"
  dc down --remove-orphans || die "Compose shutdown failed; correct the error above, then rerun ./chronicle down"
  operation_succeeded
}

doctor_add() { # id status summary action
  DOCTOR_ROWS+=("$1"$'\x1f'"$2"$'\x1f'"$3"$'\x1f'"$4")
  [[ "$2" == fail ]] && DOCTOR_FAILED=1
}

cmd_doctor() {
  shift || true
  local json=false
  if (($#)); then
    [[ "$#" -eq 1 && "$1" == --json ]] || die "usage: ./chronicle doctor [--json]"
    json=true
  fi
  source "$(dirname "$SCRIPT_PATH")/doctor.sh" || die "could not load the installed diagnostic checks"
  need_env
  begin_operation doctor diagnosis_failed
  local -a DOCTOR_ROWS=()
  local DOCTOR_FAILED=0 running=""

  doctor_check_runtime

  doctor_check_reconcile_host
  doctor_check_host_versions

  running="$(dc ps --status running --services 2>/dev/null || true)"
  doctor_check_database

  doctor_check_reviewer "$running"

  doctor_check_disk

  doctor_check_backups

  doctor_check_secrets

  doctor_check_monitoring "$running"

  doctor_render "$json"

  if [[ $DOCTOR_FAILED -eq 0 ]]; then
    operation_succeeded
    return 0
  fi
  return 1
}


require_monitoring() {
  source "$(dirname "$SCRIPT_PATH")/network-policy.sh"
  [[ "${COMPOSE_FILE:-}" == *overlays/monitoring.yml* ]] ||
    die "monitoring is disabled; rerun ./chronicle setup and enable the monitoring overlay"
}

read_viewer_password() {
  local first second
  if [[ -t 0 ]]; then
    read -rsp 'Viewer password (16+ characters): ' first; printf '\n'
    read -rsp 'Confirm viewer password: ' second; printf '\n'
  else
    IFS= read -r first || die "expected viewer password on stdin"
    IFS= read -r second || die "expected password confirmation on stdin"
  fi
  [[ "$first" == "$second" ]] || die "viewer passwords do not match"
  [[ ${#first} -ge 16 ]] || die "viewer password must be at least 16 characters"
  VIEWER_PASSWORD="$first"
}

cmd_monitoring() {
  shift || true
  [[ $# -ge 1 ]] || die "usage: ./chronicle monitoring status|add-viewer|remove-viewer|reset-viewer [name]"
  local action="$1" name="${2:-}" base
  need_env
  require_monitoring
  begin_operation "monitoring-${action}" monitoring_failed
  base="$(grafana_base_url)"
  case "$action" in
    status)
      [[ $# -eq 1 ]] || die "usage: ./chronicle monitoring status"
      printf '%sPrivate monitoring%s (%s)\n' "$BLD" "$RST" "$base"
      local monitoring_services service
      local -a monitoring_list=()
      monitoring_services="$(ops_python compose-services monitoring)" ||
        die "could not resolve the monitoring services; run ./chronicle doctor"
      while IFS= read -r service; do [[ -z "$service" ]] || monitoring_list+=("$service"); done <<<"$monitoring_services"
      dc ps -a "${monitoring_list[@]}" ||
        die "could not inspect monitoring service status; run ./chronicle doctor"
      if curl --noproxy '*' -fsS --max-time 8 --cacert "$STATE_ROOT/tls/monitoring.crt" "$base/api/health" >/dev/null 2>&1; then
        printf '  %sok%s   Grafana answers on the configured private listener\n' "$GRN" "$RST"
      else
        die "Grafana is not reachable at $base; run ./chronicle doctor"
      fi
      ;;
    add-viewer|remove-viewer|reset-viewer)
      [[ $# -eq 2 ]] || die "usage: ./chronicle monitoring ${action} NAME"
      [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] || die "viewer name must use 1..64 letters, numbers, dot, underscore, or dash"
      [[ "$name" != admin ]] || die "the Grafana admin account cannot be managed as a viewer"
      local operation="${action%-viewer}" password=""
      if [[ "$action" != remove-viewer ]]; then
        VIEWER_PASSWORD=""
        read_viewer_password
        password="$VIEWER_PASSWORD"
      fi
      if ! printf '%s\0' "$base" "${GRAFANA_ADMIN_PASSWORD:?GRAFANA_ADMIN_PASSWORD is not set}" \
        "$operation" "$name" "$password" | GRAFANA_CA_FILE="$STATE_ROOT/tls/monitoring.crt" python3 ./monitoring/grafana-user.py; then
        VIEWER_PASSWORD=""; password=""
        die "Grafana viewer operation failed; run ./chronicle logs grafana and correct the first error"
      fi
      VIEWER_PASSWORD=""; password=""
      ;;
    *) die "usage: ./chronicle monitoring status|add-viewer|remove-viewer|reset-viewer [name]" ;;
  esac
  operation_succeeded
}

ops_require_python() {
  command -v python3 >/dev/null 2>&1 || die "required command is unavailable: python3; install it with the system package manager"
  python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' ||
    die "python3 3.9 or newer is required; install it with the system package manager"
}

ops_python() {
  local script_dir launch=command
  script_dir="$(dirname "$SCRIPT_PATH")"
  export CHRONICLE_OPS_PROJECT="${PROJECT:-chronicle-selfhost}"
  export CHRONICLE_OPS_STATE="${STATE_ROOT:-$(pwd -P)}"
  export CHRONICLE_OPS_BACKUPS="${BACKUPS_HOST_DIR:-${CHRONICLE_OPS_STATE}/backups}"
  export CHRONICLE_OPS_VERSION="${RELEASE_VERSION:-unknown}"
  export CHRONICLE_OPS_TLS_MODE="${TLS_MODE:-}" CHRONICLE_OPS_EXPOSURE="${DASHBOARD_EXPOSURE:-}"
  export COMPOSE_FILE="${COMPOSE_FILE:-}"
  # These settings were resolved by need_env; deployment secrets stay out of child environments.
  local setting
  while IFS= read -r setting; do
    [[ -z "${!setting+x}" ]] || export "${setting?}"
  done < <(PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$script_dir" python3 -c \
    'from chronicle_ops.images import SOURCE_IMAGES; print("\n".join(image.variable for image in SOURCE_IMAGES))')
  for setting in HTTP_BIND HTTP_PORT INTERNAL_BIND INTERNAL_PORT CHRONICLE_PUBLIC_BASE_URL DOMAIN \
      ENABLE_ENCRYPTION POSTGRES_DB POSTGRES_IMAGE START_WAIT_TIMEOUT_SECONDS CHRONICLE_REVIEWER_ACCESS_ENABLED \
      RATE_LIMIT_MOBILE_ABUSE_EVENTS RATE_LIMIT_MOBILE_WINDOW RATE_LIMIT_RETRY_SLEEP \
      RESTORE_START_WAIT_TIMEOUT_SECONDS UPGRADE_WAIT_TIMEOUT_SECONDS MIN_FREE_DISK_GIB CHRONICLE_RECONCILE_ENABLED; do
    [[ -z "${!setting+x}" ]] || export "${setting?}"
  done
  case "$1" in restore|verify|rollback|update|operation-lock) launch="exec" ;; esac
  case "$1" in -|-c) ;; *) set -- -m chronicle_ops "$@" ;; esac
  PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$script_dir" "$launch" python3 "$@"
}

