cmd_deletion_status() {
  shift || true
  [[ $# -ge 1 && $# -le 2 ]] ||
    die "usage: ./chronicle deletion-status STUDY_UUID [OPERATION_UUID]"
  local study_id="$1" operation_id="${2:-}"
  local uuid_pattern='^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$'
  [[ "$study_id" =~ $uuid_pattern ]] || die "STUDY_UUID is not a UUID"
  [[ -z "$operation_id" || "$operation_id" =~ $uuid_pattern ]] ||
    die "OPERATION_UUID is not a UUID"
  need_env
  begin_operation deletion-status query_failed

  if ! printf '%s\n%s\n' "$study_id" "$operation_id" | dc exec -T postgres /bin/bash -euc '
    POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-$(cat "${POSTGRES_PASSWORD_FILE:?POSTGRES_PASSWORD is unavailable in the postgres container}")}"
    IFS= read -r study_id
    IFS= read -r operation_id || true
    uuid_pattern="^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    [[ "$study_id" =~ $uuid_pattern ]]
    [[ -z "$operation_id" || "$operation_id" =~ $uuid_pattern ]]
    export PGPASSWORD="$POSTGRES_PASSWORD"
    # The UUIDs reach the SQL only as psql variables (:'"'"'name'"'"' quotes them as literals), never
    # as text spliced into the statement (AF-P11).
    exec psql -X -v ON_ERROR_STOP=1 -P pager=off -v study_id="$study_id" -v operation_id="$operation_id" \
      -h 127.0.0.1 -U "${POSTGRES_USER:-chronicle}" -d "${POSTGRES_DB:-chronicle}" <<'"'"'SQL'"'"'
SELECT operation.operation_id,
       operation.mode,
       operation.status,
       operation.created_at AS requested_at,
       operation.completed_at,
       CASE
         WHEN operation.status = '\''COMPLETED'\''
          AND operation.proof_hash IS NOT NULL
          AND tombstone.proof_hash = operation.proof_hash THEN '\''verified'\''
         WHEN operation.status = '\''COMPLETED'\'' THEN '\''missing-proof'\''
         ELSE '\''pending'\''
       END AS proof_state,
       COALESCE(operation.failure_code, '\'''\'') AS failure_code
  FROM data_deletion_operations AS operation
  LEFT JOIN data_deletion_tombstones AS tombstone
    ON tombstone.operation_id = operation.operation_id
 WHERE operation.study_id = (:'\''study_id'\'')::uuid
   AND (:'\''operation_id'\'' = '\'''\'' OR operation.operation_id = (NULLIF(:'\''operation_id'\'', '\'''\''))::uuid)
 ORDER BY operation.created_at DESC;
SQL
  '; then
    die "could not query deletion operation status; confirm the stack is healthy with ./chronicle status"
  fi
  operation_succeeded
}

