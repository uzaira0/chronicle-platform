#!/usr/bin/env bash
# Chronicle self-host operator interface. It is the supported entry point and is required
# for a source clone because it initializes the needed submodules and resolves/builds the
# local images before Compose can start them.
#
# What is left is what a container genuinely cannot do:
#
#   ./chronicle setup     answer a few questions, generate secrets, write .env
#   ./chronicle check     the config checks (run in the same config-guard container that
#                         `up` gates on) PLUS the host checks no container can make:
#                         does this bind address exist here, is this port already taken,
#                         would another Compose project of this name be adopted
#   ./chronicle up [--no-reconcile]  check, then `docker compose up -d`
#   ./chronicle verify    prove from outside that the exposure boundary holds; add
#                         --dashboard-password to read and verify it without shell history
#   ./chronicle update [VERSION] [--check]  apply a signed release, or check availability (exit 3)
#   ./chronicle rollback --from OLD_DIR --trusted-sha256 SHA [--yes] DUMP
#                         restore and transfer reconciliation to the previous release
#   ./chronicle cleanup --releases-dir DIR [--apply]
#                         review or remove old releases, retaining active and recovery owners
#   ./chronicle backup    take and verify a backup through the configured sidecar
#   ./chronicle restore [--yes] [--no-start] --trusted-sha256=SHA256 [DUMP]
#                         stop every database writer, restore a separately trusted dump
#   ./chronicle restore --recover [--yes] [--no-start]
#                         resume a committed restore after a failed startup
#   ./chronicle rotate-secret [--yes] dashboard|jwt|internal-web|reviewer|metrics|postgres|postgres-app|grafana|tde
#                         rotate one credential with rollback and a mode-0600 receipt
#   ./chronicle rotate-secret recover --forward|--rollback [--yes]
#                         finish or undo a rotation a crash interrupted
#   ./chronicle deletion-status STUDY_UUID [OPERATION_UUID]
#                         inspect the live deletion ledger and proof state without subject IDs
#   ./chronicle status    what is running and healthy
#   ./chronicle doctor [--json] actionable single-host diagnosis
#   ./chronicle monitoring status|add-viewer|remove-viewer|reset-viewer
#   ./chronicle logs      follow logs
#   ./chronicle down      stop
#   ./chronicle reconcile stop|uninstall  pause or remove this deployment's schedule
#
# .env is the single source of truth, and COMPOSE_FILE in it decides the shape of the
# deployment -- which Caddy config is mounted and which ports are published. See
# .env.example for the three supported modes.
set -uo pipefail
umask 077

SCRIPT_PATH="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
cd "$(dirname "$SCRIPT_PATH")" || exit 1

# Host memory thresholds and sizing live in chronicle_ops.host_memory.
# Generated by scripts/generate-chronicle-contracts.py from ontology/chronicle.linkml.yaml
LB_MIN_BODY_BYTES=67108864
LB_MIN_HEADER_BYTES=16384
LB_MIN_IDLE_SECONDS=300
RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; BLD=$'\033[1m'; RST=$'\033[0m'
die()  { printf '%s\n' "${RED}error:${RST} $1" >&2; exit 1; }
warn() { printf '%s\n' "${YEL}warning:${RST} $1" >&2; }
ok()   { printf '  %sok%s   %s\n' "$GRN" "$RST" "$1"; }
bad()  { printf '  %sFAIL%s %s\n' "$RED" "$RST" "$1"; PREFLIGHT_FAILED=1; }

# --------------------------------------------------------------------- host probes
# The checks below inspect the host itself: which addresses it has, which ports are
# already listening, and how a directory is owned. Every tool that answers those
# questions differs between Linux and BSD/macOS, and the Linux-only spelling does not
# merely degrade there -- `ip` missing made host_has_addr return nothing, so `check`
# rejected 127.0.0.1 as "not an address on this host" and no deployment could start.
# Each helper prefers the Linux tool and falls back, so a missing tool is visible as an
# empty answer only when the host genuinely has none of them.

# Every IP address configured on this host, one per line.
host_addrs() {
  if command -v ip >/dev/null 2>&1; then
    ip -o addr show 2>/dev/null | awk '{split($4,a,"/"); print a[1]}'
  elif command -v ifconfig >/dev/null 2>&1; then
    ifconfig 2>/dev/null | awk '$1 == "inet" || $1 == "inet6" { sub(/%.*/,"",$2); print $2 }'
  fi
}

# Every listening TCP socket as addr:port, one per line.
host_listening() {
  if command -v ss >/dev/null 2>&1; then
    ss -lnt 2>/dev/null | awk 'NR > 1 { print $4 }'
  elif command -v netstat >/dev/null 2>&1; then
    # Preferred over lsof on macOS, and the ordering is load-bearing rather than stylistic.
    # `lsof` without root shows only sockets owned by the CURRENT USER, so a port held by a
    # system daemon or another account is invisible to it -- it reported nothing while
    # Tailscale was listening on 100.x.x.x:443, and `./chronicle check` passed a
    # configuration that could not bind. netstat lists every socket regardless of owner.
    # BSD netstat writes addr.port; turn the final dot into a colon.
    netstat -an -p tcp 2>/dev/null | awk '/LISTEN/ { print $4 }' | sed 's/\.\([0-9][0-9]*\)$/:\1/'
  elif command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | awk 'NR > 1 { print $9 }'
  fi | sed 's/^\[\(.*\)\]:/\1:/'
}

# GNU stat takes -c, BSD stat takes -f; neither accepts the other's flag.
stat_field() { # <gnu-format> <bsd-format> <path>
  stat -c "$1" "$3" 2>/dev/null || stat -f "$2" "$3" 2>/dev/null
}
# The address most likely to be the one a phone on the same wifi can reach: a private
# range, not loopback. Docker and VPN interfaces also live in private ranges, so this is a
# suggestion the operator confirms, never a silent choice.
lan_addr() {
  host_addrs | grep -vE '^127\.' | grep -E '^(192\.168\.|10\.|172\.(1[6-9]|2[0-9]|3[01])\.)' | sed -n 1p
}

stat_mode() { stat_field '%a' '%Lp' "$1"; }
# Deliberately NOT "chronicle": Docker Compose keys everything -- containers, networks and
# especially VOLUMES -- off the project name. A project named "chronicle" next to any other
# "chronicle" stack on the same host makes Compose treat the two as one, tearing down the
# other stack's containers and resolving this stack's postgres_data to the OTHER stack's
# chronicle_postgres_data volume. Override only if you know nothing else shares the name.
PROJECT="${COMPOSE_PROJECT_NAME:-chronicle-selfhost}"
STATE_ROOT="$(pwd -P)"
BACKUPS_HOST_DIR="${STATE_ROOT}/backups"
ACTIVE_OPERATION=""
ACTIVE_OPERATION_OUTCOME=failure
ACTIVE_OPERATION_CATEGORY=command_failed


need_env() {
  local reconcile_override_present="${CHRONICLE_RECONCILE_ENABLED+x}" reconcile_override="${CHRONICLE_RECONCILE_ENABLED:-}"
  [[ -f .env && ! -L .env ]] ||
    die ".env must be a regular file. Run ./chronicle setup, or copy .env.example and chmod 600 .env"
  local env_mode
  env_mode="$(stat_mode .env)"
  [[ "$env_mode" == 600 ]] ||
    die ".env is mode ${env_mode:-unknown}; run chmod 600 .env before using Chronicle"
  # The CLI needs these values as shell variables, but its child processes do not need the
  # entire deployment secret set in their environment. In particular, `verify` launches
  # curl repeatedly; exporting .env here made database, JWT, mobile, and metrics secrets
  # visible in every curl process even though curl never consumes them.
  # shellcheck disable=SC1091
  ops_python -c 'from chronicle_ops.envfile import read_env; from chronicle_ops.credentials import validate_rotation_configuration; validate_rotation_configuration(read_env(".env"))' || die "invalid installation configuration"
  . ./.env
  [[ "$reconcile_override_present" != x ]] || CHRONICLE_RECONCILE_ENABLED="$reconcile_override"
  # A user may have written `export KEY=...` despite the example using plain assignments, or
  # may already have exported an override. The CLI needs shell variables, but no host child
  # process needs deployment credentials. Docker Compose reads them from .env itself.
  for secret_name in POSTGRES_PASSWORD POSTGRES_APP_PASSWORD \
      CHRONICLE_INTERNAL_WEB_SECRET CHRONICLE_REVIEWER_ACCESS_SECRET \
      JWT_SECRET JWT_SECRET_PREVIOUS METRICS_PASSWORD GRAFANA_ADMIN_PASSWORD \
      DASHBOARD_PASSWORD_HASH CHRONICLE_ALERT_WEBHOOK_URL; do
    export -n "${secret_name?}" 2>/dev/null || true
  done
  # Derived on every run, never configured: Grafana joins the egress network only while the alert
  # webhook is off this host (chronicle_ops/egress.py). .env keeps a copy so a plain `docker
  # compose` renders the same networks; sync_env_file rewrites a stale copy and warns. Python
  # reads the URL (which may carry a token) from .env itself, after the secrets left the environment.
  CHRONICLE_ALERT_EGRESS="$(ops_python -c 'from chronicle_ops.egress import sync_env_file; print(sync_env_file(".env"))')" ||
    die "could not decide whether the alert webhook is off this host"
  export CHRONICLE_ALERT_EGRESS
  # Recomputed here, not at script start: .env is only sourced now, and the collision
  # guard tells operators to set COMPOSE_PROJECT_NAME there.
  PROJECT="${COMPOSE_PROJECT_NAME:-chronicle-selfhost}"
  : "${HTTP_BIND:=127.0.0.1}"
  : "${HTTP_PORT:=8080}"
  : "${HTTPS_PORT:=443}"
  : "${LOCAL_HTTPS_PORT:=443}"
  : "${LOCAL_HTTP_PORT:=80}"
  : "${INTERNAL_BIND:=127.0.0.1}"
  : "${INTERNAL_PORT:=8081}"
  : "${CHRONICLE_STATE_DIR:=.}"
  if [[ "$CHRONICLE_STATE_DIR" == /* ]]; then
    STATE_ROOT="$CHRONICLE_STATE_DIR"
  else
    STATE_ROOT="$(pwd -P)/${CHRONICLE_STATE_DIR#./}"
  fi
  STATE_ROOT="$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$STATE_ROOT")"
  BACKUPS_HOST_DIR="${STATE_ROOT}/backups"
  derive_mode
}

# The deployment mode is not a setting any more -- it IS the mode overlay in COMPOSE_FILE,
# which is what compose actually starts. Reading it back out of that one string is what
# keeps `verify` probing the deployment that exists rather than one .env describes.
derive_mode() {
  local cf="${COMPOSE_FILE:-}"
  case "$cf" in
    *mode-behind-proxy-internal*) TLS_MODE=behind-proxy; DASHBOARD_EXPOSURE=internal ;;
    *mode-own-tls-internal*)      TLS_MODE=own-tls;      DASHBOARD_EXPOSURE=internal ;;
    *mode-local-https*)           TLS_MODE=local-https;  DASHBOARD_EXPOSURE=internal ;;
    *) TLS_MODE=""; DASHBOARD_EXPOSURE="" ;;
  esac
}

# Who is running this. db-backup uses these so the dumps it writes belong to the operator
# rather than to root, which is what lets them be pruned, copied, and deleted without sudo
# (overlays/backups.yml). Exported rather than written to .env: the answer is a property of
# the account invoking the command, not of the deployment, and baking one operator's uid into
# a config file is wrong the moment a colleague runs it.
CHRONICLE_HOST_UID="$(id -u)"
CHRONICLE_HOST_GID="$(id -g)"
export CHRONICLE_HOST_UID CHRONICLE_HOST_GID

# No -f arguments: COMPOSE_FILE in .env is what selects the overlays, and Compose reads it
# from that file by itself. This is the whole reason `docker compose up -d` works without
# this script -- there is nothing here for it to be missing.
dc() {
  local anonymous
  # Plain python3, not ops_python: that exports operator settings into this shell.
  anonymous="$(PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$(dirname "$SCRIPT_PATH")" python3 -c \
    'import sys; from chronicle_ops.common import before_compose; print(*before_compose(sys.argv[1], sys.argv[2:]))' "$PROJECT" "$@")"
  if [[ -z "$anonymous" ]]; then
    docker compose -p "$PROJECT" "$@"
    return
  fi
  # This command can remove containers that mount anonymous volumes (one per VOLUME path of the
  # PostgreSQL image that no named volume covers). Compose leaves those volumes, so they are
  # removed after it (chronicle_ops/common.py after_compose). The subshell has its own signal
  # handlers: an interrupt during Compose still stops Compose, and the removal runs before this
  # script's traps do.
  (
    trap : HUP INT TERM
    status=0
    docker compose -p "$PROJECT" "$@" || status=$?
    # From here a signal ends this at once (after_compose_status stops the Docker call it waits
    # for), and the Docker calls together are limited to AFTER_COMPOSE_SECONDS.
    trap - HUP INT TERM
    after=0
    # shellcheck disable=SC2086 # one volume name per word
    PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$(dirname "$SCRIPT_PATH")" python3 -c \
      'import sys; from chronicle_ops.common import after_compose_status; sys.exit(after_compose_status(sys.argv[1], sys.argv[2:]))' "$PROJECT" $anonymous || after=$?
    if (( after > 128 )); then exit "$after"; fi
    if (( after )); then warn "could not check for anonymous volumes left by removed containers"; fi
    exit "$status"
  )
}

record_operation() {
  ops_python record-operation "$1" "$2" "${3:-none}"
}

write_operation_receipt() {
  ops_python write-operation-receipt "$1" "$2" "${3:-none}" \
    "$(( SECONDS - ${OPERATION_STARTED_SECONDS:-$SECONDS} ))"
}

operation_exit() {
  local status=$?
  trap - EXIT
  if [[ -n "$ACTIVE_OPERATION" ]]; then
    if [[ $status -eq 0 && "$ACTIVE_OPERATION_OUTCOME" == success ]]; then
      write_operation_receipt "$ACTIVE_OPERATION" success none ||
        warn "the command completed, but its local operation receipt could not be written"
      record_operation "$ACTIVE_OPERATION" success none
    else
      write_operation_receipt "$ACTIVE_OPERATION" failure "$ACTIVE_OPERATION_CATEGORY" ||
        warn "the command failed, and its local operation receipt could not be written"
      record_operation "$ACTIVE_OPERATION" failure "$ACTIVE_OPERATION_CATEGORY"
    fi
  fi
  exit "$status"
}

begin_operation() {
  ACTIVE_OPERATION="$1"
  OPERATION_STARTED_SECONDS=$SECONDS
  ACTIVE_OPERATION_OUTCOME=failure
  ACTIVE_OPERATION_CATEGORY="${2:-command_failed}"
  trap operation_exit EXIT
  # Ctrl-C must record the same honest "this did not finish" receipt that any other failure
  # does. Without these, bash can die on the signal without running the EXIT trap, and the
  # operation log simply has no entry -- the one case where an operator most wants to know
  # what state the stack was left in. cmd_restore already traps all four; up/setup/upgrade
  # were relying on EXIT alone.
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

operation_succeeded() { ACTIVE_OPERATION_OUTCOME=success; ACTIVE_OPERATION_CATEGORY=none; }

# ---------------------------------------------------------------------------- preflight
preflight_addresses() {
  # A bind address the host does not actually have produces an opaque Docker error at
  # `up` time, long after the operator has stopped looking at .env.
  host_has_addr() {
    [[ "$1" == "0.0.0.0" ]] && return 0
    host_addrs | grep -x "$1" >/dev/null
  }
  local -a bind_specs=("HTTP_BIND:${HTTP_BIND}" "INTERNAL_BIND:${INTERNAL_BIND}")
  [[ "${COMPOSE_FILE:-}" == *overlays/monitoring.yml* ]] && bind_specs+=("GRAFANA_BIND:${GRAFANA_BIND:-127.0.0.1}")
  for spec in "${bind_specs[@]}"; do
    local name="${spec%%:*}" addr="${spec#*:}"
    [[ "$name" == INTERNAL_BIND && "$DASHBOARD_EXPOSURE" != internal ]] && continue
    # The own-tls and local-https modes bind 443/80 on every interface; HTTP_BIND is
    # unused there.
    [[ "$name" == HTTP_BIND && "$TLS_MODE" != behind-proxy ]] && continue
    if host_has_addr "$addr"; then
      # Loopback is an address on every host, so saying so proves nothing -- and printing a
      # green line about a variable that guard-config has already warned is loopback-only
      # reads as a contradiction. Only report the case that carried information.
      [[ "$addr" == 127.0.0.1 || "$addr" == "0.0.0.0" ]] ||
        ok "${name}=${addr} is an address on this host"
    else
      bad "${name}=${addr} is not an address on this host. Available: $(host_addrs | tr '\n' ' ')"
    fi
  done
}

preflight_listeners() {
  # Ports held by THIS stack's own corresponding container are not a conflict -- otherwise
  # `check` fails against a deployment that is already up.
  # Scoped to the service that owns each listener, not to the whole project. A running web
  # container must not hide a new Grafana/Fluent collision, and vice versa.
  local port_specs=("INTERNAL_PORT:${INTERNAL_PORT}:${INTERNAL_BIND}:${WEB_PORT_OWNERS}")
  if [[ "$TLS_MODE" == local-https ]]; then
    port_specs+=("LOCAL_HTTPS_PORT:${LOCAL_HTTPS_PORT}:0.0.0.0:${WEB_PORT_OWNERS}"
                 "LOCAL_HTTP_PORT:${LOCAL_HTTP_PORT}:0.0.0.0:${WEB_PORT_OWNERS}")
  elif [[ "$TLS_MODE" == own-tls ]]; then
    port_specs+=("HTTPS_PORT:${HTTPS_PORT}:0.0.0.0:${WEB_PORT_OWNERS}"
                 "TLS_HTTP_PORT:${TLS_HTTP_PORT:-80}:0.0.0.0:${WEB_PORT_OWNERS}")
  else
    port_specs+=("HTTP_PORT:${HTTP_PORT}:${HTTP_BIND}:${WEB_PORT_OWNERS}")
  fi
  if [[ "${COMPOSE_FILE:-}" == *overlays/monitoring.yml* ]]; then
    port_specs+=("GRAFANA_PORT:${GRAFANA_PORT:-3000}:${GRAFANA_BIND:-127.0.0.1}:${GRAFANA_PORT_OWNERS}")
    port_specs+=("FLUENT_BIT_FORWARD_PORT:${FLUENT_BIT_FORWARD_PORT:-24224}:127.0.0.1:${FLUENT_BIT_PORT_OWNERS}")
  fi
  for spec in "${port_specs[@]}"; do
    local pname="${spec%%:*}" rest="${spec#*:}" pservice="${spec##*:}"
    rest="${rest%:*}"
    local pport="${rest%%:*}" paddr="${rest#*:}"
    [[ "$pname" == INTERNAL_PORT && "$DASHBOARD_EXPOSURE" != internal ]] && continue
    if owns_listener "$PROJECT" "$pservice" "$paddr" "$pport"; then
      continue
    fi
    # A bind on 0.0.0.0 collides with a listener on ANY address, not just 0.0.0.0 --
    # macOS refuses the wildcard bind when a specific address already holds the port. Docker
    # does not surface that: `docker compose ps` still prints 0.0.0.0:443->443 and the
    # container is healthy, while every connection from the host times out. Observed here
    # with Tailscale serving on 100.x.x.x:443 and the own-tls/local-https modes publishing
    # 0.0.0.0:443 -- the old pattern below only matched the exact bind address or 0.0.0.0,
    # so it reported nothing and the failure looked like a broken deployment.
    local pattern="(^|:)(${paddr//./\.}|0\.0\.0\.0|::|\*):${pport}$"
    [[ "$paddr" == "0.0.0.0" ]] && pattern=":${pport}$"
    local holder; holder=$(host_listening | grep -E "$pattern" | sed -n 1p)
    if [[ -n "$holder" ]]; then
      bad "${pname}=${pport} is already in use (${holder}) by another process"
      [[ "$paddr" == "0.0.0.0" ]] && \
        printf '       This mode binds every interface, so a listener on ANY address holds\n' && \
        printf '       the port. Stop that process or move it off %s.\n' "$pport"
    fi
  done
}

preflight_environment() {
  local subnet_check
  # Overlaps and an unreadable network table only warn (network-subnet.py check exits 0).
  if ! subnet_check="$(dc config --format json | python3 ./network-subnet.py check 2>&1)"; then
    warn "${subnet_check:-could not check CHRONICLE_SUBNET against Docker networks}"
  elif [[ -n "$subnet_check" ]]; then
    printf '%s\n' "$subnet_check" >&2
  fi

  # Refuse to adopt somebody else's stack. If a Compose project of this name already
  # exists and was not created from this directory, `up` would recreate ITS containers and
  # mount ITS volumes -- data loss in another deployment, from a command that looks routine.
  local foreign
  foreign=$(foreign_project "$PROJECT") || die "could not establish Compose project ownership"
  if [[ -n "$foreign" ]]; then
    bad "a different Compose project named '${PROJECT}' already exists on this host (${foreign}). Starting would recreate its containers and mount its volumes. Set COMPOSE_PROJECT_NAME in .env to something unique."
  else
    ok "compose project '${PROJECT}' does not collide with another stack"
  fi

  # Compose bind-mounts this directory AND files below it (./config, ./caddy, ./monitoring,
  # the entrypoint scripts) read-only into containers that run as their image's own user
  # (backend as uid 100, config-guard as the postgres uid). An extraction under a private
  # umask leaves every directory 0700 and every file 0600, which fails inside the container
  # as a bare "Permission denied", so say it here with the fix. ./backups,
  # ./operator-receipts, ./upgrade-receipts, ./tls and .env are deliberately owner-only and are
  # left alone, and so is ./local-edits: an update saves the operator's edited files there,
  # owner-only, before it changes anything, and when it is then refused or rolled back this
  # directory is still the installed one.
  local -a keep_private=( '(' -path ./backups -o -path ./operator-receipts -o -path ./upgrade-receipts -o -path ./local-edits -o -path ./tls -o -name '.env*' -o -name .git -o -name '.chronicle-*' -o -name '.reconcile*' -o -name 'reconcile.*' -o -name __pycache__ ')' -prune )
  local unreadable permission_repair
  unreadable=$(find . "${keep_private[@]}" -o \
    '(' '(' -type d ! -perm -0005 ')' -o '(' -type f ! -perm -0004 ')' ')' -print 2>/dev/null | sort | sed -n 1,5p | tr '\n' ' ')
  if [[ -n "$unreadable" ]]; then
    printf -v permission_repair '%q ' find . "${keep_private[@]}" -o -exec chmod a+rX '{}' +
    bad "bundle paths the container users cannot read (a private umask on extraction does this): ${unreadable}. From this selfhost directory run: ${permission_repair}"
  else
    ok "bundle files and directories are readable by the container users"
  fi

  # Signed mobile requests are accepted within a 5-minute window with 30 s of skew, and TLS
  # validity and scheduled backups also read the clock. An unsynchronized host rejects
  # uploads with no other visible cause, so say so here.
  local ntp_synced=""
  if command -v timedatectl >/dev/null 2>&1; then
    ntp_synced=$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)
  elif command -v chronyc >/dev/null 2>&1; then
    chronyc tracking 2>/dev/null | grep 'Leap status *: Normal' >/dev/null && ntp_synced=yes || ntp_synced=no
  fi
  case "$ntp_synced" in
    yes) ok "host clock is NTP-synchronized" ;;
    no)  warn "host clock is not NTP-synchronized; signed uploads fail beyond 30 s of skew. Run: sudo timedatectl set-ntp true (or enable chronyd)" ;;
    *)   warn "could not confirm NTP synchronization (no timedatectl or chronyc); keep the host clock within 30 s" ;;
  esac
}

preflight_resources() {
  # Postgres stops hard when the disk fills and does not come back on its own. Refuse to
  # start below a floor so operators without the monitoring overlay are still stopped
  # before that happens.
  if ops_python storage-check; then
    ok "state, Docker data and database filesystems have byte and inode reserve"
  else
    bad "storage reserve failed; inspect df -h and df -i on the reported backing filesystems"
  fi

  local tool missing_tools=""
  for tool in openssl python3 curl; do
    command -v "$tool" >/dev/null 2>&1 || missing_tools+=" $tool"
  done
  if [[ -n "$missing_tools" ]]; then
    bad "missing host tools:${missing_tools}. Install them with the system package manager (apt/dnf/brew)"
  else
    ok "host tools present (curl, openssl, python3)"
  fi

  if [[ "${COMPOSE_FILE:-}" == *overlays/backups.yml* ]] && ! ops_python backup-storage; then
    bad "backup storage does not meet encryption readiness; rerun setup to confirm storage or record a reviewed waiver"
  fi

  if ! ops_python database-storage; then
    bad "database storage does not meet encryption readiness; rerun setup to confirm storage or record a reviewed waiver"
  fi

  # up/restore use --wait-timeout, which Compose added in 2.17.
  local compose_version
  compose_version=$(docker compose version --short 2>/dev/null | sed 's/^v//')
  if printf '2.17.0\n%s\n' "${compose_version%%-*}" | sort -V -C 2>/dev/null; then
    ok "docker compose ${compose_version}"
  else
    bad "docker compose ${compose_version:-not found} is older than 2.17.0; install the current Docker Compose plugin"
  fi

  preflight_runtime_versions

  local memory_warning
  memory_warning=$(ops_python host-memory check) || die "could not check host memory"
  [[ -z "$memory_warning" ]] || warn "$memory_warning"
  # Every service's mem_limit from the rendered configuration, monitoring included (warn only).
  memory_warning=$(ops_python host-memory ceilings 2>/dev/null) ||
    memory_warning="could not render the Compose configuration to compare memory ceilings with host memory"
  [[ -z "$memory_warning" ]] || warn "$memory_warning"
  # Warn only: the shipped fluentd-buffer-limit is provisional.
  if [[ "${COMPOSE_FILE:-}" == *overlays/monitoring.yml* ]]; then
    memory_warning=$(ops_python host-memory logging) || die "could not render the Compose logging configuration"
    [[ -z "$memory_warning" ]] || warn "$memory_warning"
    [[ -n "${CHRONICLE_ALERT_WEBHOOK_URL:-}" ]] ||
      printf '  note: no CHRONICLE_ALERT_WEBHOOK_URL; scheduled reconciliation writes firing alerts to the host system log (journalctl -t chronicle; docs/MONITORING-RUNBOOK.md)\n'
  fi

  if [[ -x ./verify-config.sh ]]; then
    if ./verify-config.sh >/dev/null 2>&1; then ok "internal config contract intact"
    else bad "verify-config.sh reports drift — run ./verify-config.sh for detail"; fi
  fi
}

# Docker Engine, containerd, runc and kernel versions below the 2026 CVE minimums are warnings on
# every path (chronicle_ops/host_versions.py); they never stop setup, check, up or update.
preflight_runtime_versions() {
  local rows row_status message
  if ! rows="$(ops_python host-versions)"; then
    warn "could not read the Docker Engine, containerd, runc and kernel versions; check them against the README Requirements"
    return 0
  fi
  while IFS=$'\t' read -r row_status message; do
    [[ -n "$row_status" ]] || continue
    if [[ "$row_status" == ok ]]; then ok "$message"; else warn "$message"; fi
  done <<<"$rows"
}

# The release images are linux/amd64 only (chronicle_ops/host_versions.py architecture_assessment).
# On another Docker daemon architecture the bundled image is run once with --platform linux/amd64:
# when it runs (Docker Desktop, OrbStack, binfmt emulation) everything proceeds with a warning that
# performance is emulated. Only a daemon that cannot run amd64 code at all makes a fresh setup refuse
# and check fail; up, re-setup and update only warn, so an existing deployment is never stopped.
preflight_architecture() {
  local problem status=0
  problem="$(ops_python host-architecture 2>/dev/null)" || status=$?
  [[ -n "$problem" ]] || return 0
  if ((status != 1)); then
    warn "$problem"
    return 0
  fi
  case "$1" in
    setup) die "$problem" ;;
    check) bad "$problem" ;;
    *) warn "$problem" ;;
  esac
}

preflight() {
  PREFLIGHT_FAILED=0
  preflight_architecture "${1:-up}"

  # Host checks run FIRST, before the config-guard container. They are pure local reads --
  # addresses, listening sockets, other Compose projects -- so they cost milliseconds, while
  # config-guard costs a container start. They are also what a first-time operator actually
  # trips over (a port already held, a project name that collides), and failing on those
  # after a wall of green configuration checks buries the one line that matters.
  printf '%sChecking this host%s\n' "$BLD" "$RST"

  # What follows cannot move into that container. A container has its own network namespace
  # and its own /proc, so it can see neither this host's addresses nor its listening
  # sockets, and it has no Docker socket to ask about other Compose projects. On the plain
  # `docker compose up -d` path Docker's own bind error is the fallback for the first two --
  # later and less specific, but not silent.

  preflight_addresses
  preflight_listeners
  preflight_environment
  if [[ $PREFLIGHT_FAILED -eq 0 ]]; then preflight_resources; fi

  # Stop here rather than spending a container start on the configuration checks when the
  # host already cannot host this deployment. The operator gets the failure in under a
  # second, with nothing else on screen competing for attention.
  [[ $PREFLIGHT_FAILED -eq 0 ]] || die "this host cannot run this deployment (see FAIL above)"

  # Every configuration check lives in guard-config.sh and runs in the config-guard service,
  # because that is what `docker compose up -d` enforces. Running the same container here
  # rather than re-implementing the checks is what keeps `./chronicle check` and a plain
  # `docker compose up -d` from ever disagreeing about what is safe.
  #
  # --no-deps so neither drags the stack up. secrets-init first: the guard checks the credential
  # files it writes from .env, exactly what the services will read.
  printf '\n'
  if ! dc run --rm --no-deps secrets-init >/dev/null || ! dc run --rm --no-deps config-guard; then
    PREFLIGHT_FAILED=1
  fi

  [[ $PREFLIGHT_FAILED -eq 0 ]] || die "configuration is not safe to deploy (see FAIL above)"
}

# Config files of a Compose project of this name that was created somewhere other than
# this directory, or nothing. `up` refuses to adopt such a stack; setup uses the same
# answer to pick a name that will not need refusing.
foreign_project() {
  ops_python -c 'import sys; from chronicle_ops.release import foreign_project; print(foreign_project(".", sys.argv[1]))' \
    "$1" || die "could not establish Compose project ownership"
}

# The first port at or above $1 that nothing on this host is already listening on for
# address $2. Same reasoning as the project name below: on a host that already runs one
# deployment, the defaults are taken, and preflight would only say so after setup ended.
free_port() {
  local port="$1" addr="$2" excluded_port="${3:-}" pattern tries=0
  while ((tries < 100)); do
    pattern="(^|:)(${addr//./\\.}|0\.0\.0\.0|::|\*):${port}\$"
    [[ "$addr" == "0.0.0.0" ]] && pattern=":${port}\$"
    if [[ "$port" != "$excluded_port" ]] && ! host_listening | grep -E "$pattern" >/dev/null; then
      printf '%s\n' "$port"
      return 0
    fi
    port=$((port + 1)); tries=$((tries + 1))
  done
  return 1
}

# The services that hold each listener: since 2026.11.12 the forwarders publish the ports of web,
# Grafana and Fluent Bit (docs/NETWORK-EGRESS.md); a stack started by an older release still has
# them on the services themselves until its update.
WEB_PORT_OWNERS=web-forward,web
GRAFANA_PORT_OWNERS=monitoring-forward,grafana
FLUENT_BIT_PORT_OWNERS=monitoring-forward,fluent-bit

owns_listener() { # <project> <service[,service...]> <address> <port>
  local container service
  local -a services
  IFS=, read -r -a services <<<"$2"
  for service in "${services[@]}"; do
    while IFS= read -r container; do
      [[ -n "$container" ]] || continue
      if docker inspect --format '{{json .NetworkSettings.Ports}}' "$container" 2>/dev/null |
        python3 -c 'import ipaddress,json,sys
ports=json.load(sys.stdin) or {}
wanted=ipaddress.ip_address(sys.argv[1])
sys.exit(not any(ipaddress.ip_address(p["HostIp"]) == wanted and p["HostPort"] == sys.argv[2]
                 for bindings in ports.values() for p in bindings or []))' "$3" "$4"; then
        return 0
      fi
    done < <(docker ps --filter "label=com.docker.compose.project=$1" \
        --filter "label=com.docker.compose.service=${service}" --format '{{.ID}}' 2>/dev/null)
  done
  return 1
}

# The port an existing .env gave <service> when this project's own container for it is
# running and so holds that port; otherwise free_port from the saved value or the default.
# Without this, re-running setup on a live deployment moves it to the next free port.
setup_port() { # <project> <service> <saved> <default> <addr> [excluded]
  local project="$1" service="$2" saved="$3" default="$4" addr="$5" excluded="${6:-}"
  if [[ -n "$saved" && "$saved" != "$excluded" ]] && owns_listener "$project" "$service" "$addr" "$saved"; then
    printf '%s\n' "$saved"
    return 0
  fi
  free_port "${saved:-$default}" "$addr" "$excluded"
}

# Prompts until the answer is an address this host has, so setup never writes a bind that
# `check` refuses later. [wildcard] allows 0.0.0.0 (the load-balancer listener only).
ask_bind_addr() { # <default> [wildcard]
  local answer
  while true; do
    read -rp "Address [$1]: " answer
    answer="${answer:-$1}"
    if ! bash ./guard-config.sh --validate-listener-address "$answer"; then
      printf 'This listener requires an IPv4 address.\n' >&2
      continue
    fi
    case "$answer" in
      0.0.0.0|::|\[::\])
        [[ "${2:-}" == wildcard && "$answer" == 0.0.0.0 ]] && { printf '%s\n' "$answer"; return; }
        printf 'This listener may not bind every interface; give one address.\n' >&2 ;;
      127.0.0.1) printf '%s\n' "$answer"; return ;;
      *)
        host_addrs | grep -x "$answer" >/dev/null && { printf '%s\n' "$answer"; return; }
        printf '%s is not an address on this host. This host has: %s\n' \
          "$answer" "$(host_addrs | tr '\n' ' ')" >&2 ;;
    esac
  done
}

# ------------------------------------------------------------------------------- setup
setup_validate_preserved_credentials() {
    [[ "$keep_project" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || keep_project=""
    [[ "$keep_pg" != *CHANGE_ME* ]] || keep_pg=""
    [[ "$keep_pg_app" != *CHANGE_ME* ]] || keep_pg_app=""
    [[ "$keep_jwt" != *CHANGE_ME* ]] || keep_jwt=""
    [[ "$keep_metrics" != *CHANGE_ME* ]] || keep_metrics=""
    [[ "$keep_internal" != *CHANGE_ME* ]] || keep_internal=""
    [[ "$keep_reviewer_enabled" == true ]] || keep_reviewer_enabled=false
    [[ "$keep_reviewer_secret" != *CHANGE_ME* ]] || keep_reviewer_secret=""
    [[ "$keep_grafana" != *CHANGE_ME* && "$keep_grafana" != *changeme* ]] || keep_grafana=""
    [[ "$keep_dash_hash" == '$2'* ]] || keep_dash_hash=""
    [[ -n "$keep_state" ]] || keep_state="."
    case "$keep_state" in
      /*) setup_state_root="$keep_state" ;;
      *) setup_state_root="$(pwd -P)/${keep_state#./}" ;;
    esac
}

setup_existing_settings() {
  signing_fingerprint="$(ssh-keygen -lf release-signing.pub)" || die "cannot read the installed release-signing public key"
  printf 'Public key shipped in the bundle. Installed fingerprint: %s\n' "$signing_fingerprint"
  printf "Compare it with the fingerprint the maintainer sent separately by email or message from your study's Chronicle contact. If it differs, stop. Do not install.\n"
  begin_operation setup setup_failed
  setup_outcome="write"
  # Preserve credentials during re-setup; rotation is an explicit operation.
  keep_pg="" keep_pg_app="" keep_jwt="" keep_metrics="" keep_internal=""
  keep_public_base_url=""
  keep_alert_webhook=""
  keep_reviewer_enabled="false" keep_reviewer_secret="" keep_reviewer_study=""
  keep_reviewer_participant=""
  keep_grafana="" keep_dash_hash="" keep_state="."
  keep_http_port="" keep_internal_port="" keep_grafana_port="" keep_project=""
  keep_local_https_port="" keep_local_http_port=""
  keep_subnet=""
  # Rotation, restore and upgrade lock the state directory and rewrite .env. Setup must not
  # run under them, nor publish values it read before one of them changed .env.
  setup_state_root="$STATE_ROOT" env_snapshot=""
  if [[ -f .env ]]; then
    need_env
    ops_python owner-check || die "setup must run from the active selfhost directory"
    read -rp "$(printf '%s.env already exists. Overwrite? [y/N] %s' "$YEL" "$RST")" a
    # Only a clear yes overwrites; anything else, including an unrecognised answer, keeps .env.
    { yes_no_answer "$a" && [[ "$YES_NO_ANSWER" == yes ]]; } || {
      echo "Keeping existing .env."
      need_env
      operation_succeeded
      setup_outcome=kept
      return 0
    }
    env_snapshot=".env.backup.$(date +%Y%m%d%H%M%S)"
    cp .env "$env_snapshot"
    need_env
    keep_pg="${POSTGRES_PASSWORD:-}"
    keep_pg_app="${POSTGRES_APP_PASSWORD:-}"
    keep_jwt="${JWT_SECRET:-}"
    keep_metrics="${METRICS_PASSWORD:-}"
    keep_internal="${CHRONICLE_INTERNAL_WEB_SECRET:-}"
    keep_public_base_url="${CHRONICLE_PUBLIC_BASE_URL:-}"
    keep_alert_webhook="${CHRONICLE_ALERT_WEBHOOK_URL:-}"
    keep_reviewer_enabled="${CHRONICLE_REVIEWER_ACCESS_ENABLED:-}"
    keep_reviewer_secret="${CHRONICLE_REVIEWER_ACCESS_SECRET:-}"
    keep_reviewer_study="${CHRONICLE_REVIEWER_STUDY_ID:-}"
    keep_reviewer_participant="${CHRONICLE_REVIEWER_PARTICIPANT_ID:-}"
    keep_grafana="${GRAFANA_ADMIN_PASSWORD:-}"
    keep_dash_hash="${DASHBOARD_PASSWORD_HASH:-}"
    keep_state="${CHRONICLE_STATE_DIR:-}"
    keep_http_port="${HTTP_PORT:-}"
    keep_local_https_port="${LOCAL_HTTPS_PORT:-}"
    keep_local_http_port="${LOCAL_HTTP_PORT:-}"
    keep_internal_port="${INTERNAL_PORT:-}"
    keep_grafana_port="${GRAFANA_PORT:-}"
    keep_subnet="${CHRONICLE_SUBNET:-}"
    keep_core_prefix="${CHRONICLE_CORE_PREFIX:-}"
    keep_project="${COMPOSE_PROJECT_NAME:-}"
    setup_validate_preserved_credentials
    if [[ -n "$keep_pg" ]]; then
      printf '%sKeeping existing deployment secrets and dashboard password hash.%s\n' "$GRN" "$RST"
      printf '  Silent rotation could lock out the database, enrolled phones, monitoring, or\n'
      printf '  researchers. Follow the documented rotation procedure to change one deliberately.\n\n'
    fi
  fi
  STATE_ROOT="$setup_state_root" assert_no_incomplete_mutation "run setup"

  return 0
}

setup_mode_and_domain() {
  printf '%sChronicle self-host setup%s\n\n' "$BLD" "$RST"

  # Asked before the hostname, because the answer changes what a hostname even means: in
  # the trial mode it is this machine's wifi address, not a name anyone resolves.
  printf 'What is this deployment?\n'
  printf '  1) A server behind my institution'\''s load balancer, which terminates TLS  (recommended)\n'
  printf '  2) A server that terminates TLS itself, with a certificate I already have\n'
  printf '  3) A trial on this machine, with test phones on the same wifi  (no domain needed)\n'
  mode_default=1 previous_mode="${TLS_MODE:-}"
  [[ "$previous_mode" != own-tls ]] || mode_default=2
  [[ "$previous_mode" != local-https ]] || mode_default=3
  read -rp "Choice [$mode_default]: " tls_choice
  tls_mode=behind-proxy
  case "${tls_choice:-$mode_default}" in
    2) tls_mode=own-tls ;;
    3) tls_mode=local-https ;;
  esac
  # A re-setup that leaves the trial mode must not carry the trial's private-IP
  # CHRONICLE_PUBLIC_BASE_URL into a production .env; guard-config rejects it and names a
  # variable this wizard never asked about. Only the local-https branch below sets it.
  [[ "$previous_mode" != local-https || "$tls_mode" == local-https ]] || keep_public_base_url=""

  http_bind=127.0.0.1 exposure=internal internal_bind=127.0.0.1

  if [[ "$tls_mode" == local-https ]]; then
    # The phones dial this address directly, so it must be one this machine really has on
    # the network they are on. Offering the detected addresses is the difference between a
    # working trial and twenty minutes of "connection refused" -- `localhost` is the
    # intuitive answer here and the one that cannot work.
    suggested=$(lan_addr)
    printf '\nThis machine'\''s addresses: %s\n' "$(host_addrs | tr '\n' ' ')"
    printf 'Which one are the phones on the same network as?\n'
    read -rp "Address [${suggested:-none detected}]: " domain
    domain="${domain:-$suggested}"
    [[ -n "$domain" ]] || die "an address is required — none could be detected automatically"
    bash ./guard-config.sh --validate-listener-address "$domain" ||
      die "$(ops_python -c 'from gettext import gettext as _; print(_("Trial mode requires an IPv4 address."))')"
    case "$domain" in
      localhost|127.*) die "$domain is only reachable from this machine; a phone cannot use it" ;;
    esac
    host_addrs | grep -x "$domain" >/dev/null ||
      die "$domain is not an address on this machine; choose one of: $(host_addrs | tr '\n' ' ')"
    # config-guard refuses the trial on a public address; say so here, not at `up`.
    if bash ./guard-config.sh --validate-public-host "$domain"; then
      die "$domain is a public address; the trial mode is only for a private LAN address (use choice 1 or 2 for a public host)"
    fi
    # Everything else is forced: a trial mode whose CA nobody trusts has no public variant,
    # and the dashboard has no reason to leave this machine.
    printf '\nThe dashboard will be at https://127.0.0.1:%s on this machine only.\n' "${INTERNAL_PORT:-8081}"
  else
    read -rp "Public hostname for participants [${DOMAIN:-chronicle.example.org}]: " domain
    domain="${domain:-${DOMAIN:-chronicle.example.org}}"
    [[ -n "$domain" ]] || die "a hostname is required"
    # The same classifier `up` runs in config-guard. Asked here, a mistyped or private name
    # costs one question, not the whole wizard.
    bash ./guard-config.sh --validate-public-host "$domain" ||
      die "$domain is not a public DNS name or globally routable address; production modes need one (use choice 3 for a trial on this network)"

    # Ask where the proxy will connect. Defaulting this to 127.0.0.1 is a trap when the load
    # balancer lives on another host: the stack starts, `check` passes, and `verify` passes
    # too -- it probes from inside the box, so it sees a perfectly healthy server -- while
    # the proxy gets connection refused. Every local signal reads green and nothing works.
    if [[ "$tls_mode" == behind-proxy ]]; then
      printf '\nWhich address will your load balancer connect to?\n'
      printf '  This host has: %s\n' "$(host_addrs | tr '\n' ' ')"
      printf '  Use 127.0.0.1 ONLY if the proxy runs on this same machine.\n'
      http_bind=$(ask_bind_addr "${HTTP_BIND:-127.0.0.1}" wildcard)
    fi

    printf '\nThe supported release always keeps the researcher dashboard on a private listener.\n'
    printf 'Which address should the dashboard listen on?\n'
    printf '  Your VPN or management interface, e.g. 10.0.0.5.\n'
    printf '  Leave blank for 127.0.0.1 (reach it over an SSH tunnel).\n'
    internal_bind=$(ask_bind_addr "${INTERNAL_BIND:-127.0.0.1}")
  fi

  source ./network-policy.sh
  return 0
}

setup_network_policy() {
  initial_subnet="${keep_subnet:-$(sed -n 's/^CHRONICLE_SUBNET=//p' .env.example | sed -n 1p | tr -d "'\"")}"
  gateway=$(ops_python -c 'import sys; from chronicle_ops.common import compose_gateway; print(compose_gateway(sys.argv[1]))' "$initial_subnet") || die "invalid Compose subnet"
  researcher_sources_default="$gateway/32 127.0.0.1/32 ::1/128"
  trusted_proxies_default=$(trusted_proxy_sources "$tls_mode" "$http_bind" "$gateway" "${CADDY_TRUSTED_PROXIES:-}") || trusted_proxies_default=""
  public_origin="${keep_public_base_url:-https://$domain}" trusted_proxies="$trusted_proxies_default"
  pool_sources="${POOL_ALLOWED_IPS:-}" pool_port="${HTTP_PORT:-8080}" public_http="${PUBLIC_HTTP_ENABLED:-false}"
  # Participant API keys also need encryption on the same-host load-balancer hop.
  # A saved false or empty value does not count; only a reviewed waiver keeps plain HTTP, so
  # re-setup reaches the answer a fresh setup reaches and config-guard accepts.
  pool_tls="${POOL_LISTENER_TLS:-true}"
  if [[ "$tls_mode" == behind-proxy ]] &&
      ! bash ./guard-config.sh --pool-plaintext-waived "${POOL_PLAINTEXT_WAIVER:-}"; then
    pool_tls=true
  fi
  researcher_sources="${DASHBOARD_ALLOWED_IPS:-$researcher_sources_default}" management_url="${DASHBOARD_BASE_URL:-}" management_url_default=false
  if [[ "$internal_bind" == 127.* || "$internal_bind" == ::1 ]] && loopback_networks "$researcher_sources"; then
    researcher_sources="$researcher_sources_default"
  fi
  [[ -n "$management_url" ]] || management_url_default=true
  if [[ "$tls_mode" != local-https ]]; then
    while :; do
      read -rp "Exact public HTTPS origin [$public_origin]: " a || die "public HTTPS origin is required"
      keep_public_base_url="${a:-$public_origin}"
      bash ./guard-config.sh --validate-public-origin "$keep_public_base_url" && break
      printf 'Use an HTTPS root origin with a public hostname or globally routable IP.\n' >&2
    done
    read -rp "Public HTTP redirect exposed? [${public_http}]: " a
    public_http="${a:-$public_http}"
    [[ "$public_http" == true || "$public_http" == false ]] || die "HTTP policy must be true or false"
    if [[ "$tls_mode" == behind-proxy ]]; then
      read -rp "Load balancer source CIDRs [$trusted_proxies]: " a
      trusted_proxies="${a:-$trusted_proxies}"
      trusted_proxies=$(trusted_proxy_sources "$tls_mode" "$http_bind" "$gateway" "$trusted_proxies") ||
        die "remote load balancer source CIDRs are required; loopback and Docker gateway trust cannot identify a remote LB"
      if [[ -z "$pool_sources" ]] && ! loopback_networks "$trusted_proxies"; then
        pool_sources="$trusted_proxies"
      fi
      read -rp "Pool ingress source CIDRs, '-' for any source [${pool_sources:--}]: " a
      a="${a:-$pool_sources}"; [[ "$a" == - ]] && a=""
      pool_sources="$a"
      [[ -z "$pool_sources" ]] || bash ./guard-config.sh --validate-forwarder-cidrs "$pool_sources" || die "invalid pool ingress CIDRs"
      printf 'The LB must replace X-Forwarded-Proto with https. Client X-Forwarded-For is optional.\n'
      printf 'SNAT without client XFF groups phones under the LB address; trust settings cannot recover the client.\n'
      read -rp "LB destination port [$pool_port]: " a
      pool_port="${a:-$pool_port}"
      [[ "$pool_port" =~ ^[0-9]+$ ]] && ((pool_port > 0 && pool_port <= 65535)) || die "invalid LB destination port"
      keep_http_port="$pool_port"
      [[ "$pool_tls" != true ]] ||
        printf 'The pool listener serves TLS (POOL_LISTENER_TLS=true): the LB must trust ./tls/internal-ca.crt.\n'
    fi
    lb_body="${LB_MAX_BODY_BYTES:-$LB_MIN_BODY_BYTES}" lb_idle="${LB_IDLE_TIMEOUT_SECONDS:-$LB_MIN_IDLE_SECONDS}" lb_headers="${LB_MAX_HEADER_BYTES:-$LB_MIN_HEADER_BYTES}"
    read -rp "LB maximum request bytes [$lb_body]: " a; lb_body="${a:-$lb_body}"
    read -rp "LB idle timeout seconds [$lb_idle]: " a; lb_idle="${a:-$lb_idle}"
    read -rp "LB maximum header bytes [$lb_headers]: " a; lb_headers="${a:-$lb_headers}"
    [[ "$lb_body" =~ ^[0-9]+$ && "$lb_idle" =~ ^[0-9]+$ && "$lb_headers" =~ ^[0-9]+$ ]] || die "LB limits must be positive integers"
    (( lb_body >= LB_MIN_BODY_BYTES && lb_idle >= LB_MIN_IDLE_SECONDS && lb_headers >= LB_MIN_HEADER_BYTES )) || die "LB must support ${LB_MIN_BODY_BYTES}-byte bodies, ${LB_MIN_HEADER_BYTES}-byte headers and ${LB_MIN_IDLE_SECONDS}-second idle streaming"
    printf 'Host access and SSH tunnels reach Caddy through the Compose gateway; the default includes it.\n'
    read -rp "Researcher source CIDRs [$researcher_sources]: " a
    researcher_sources="${a:-$researcher_sources}"
    bash ./guard-config.sh --validate-forwarder-cidrs "$researcher_sources" || die "invalid researcher source CIDRs"
    management_host="$internal_bind"
    [[ "$management_host" != *:* ]] || management_host="[$management_host]"
    management_url="${management_url:-https://$management_host:${INTERNAL_PORT:-8081}}"
    read -rp "Researcher HTTPS origin [$management_url]: " a
    [[ -z "$a" ]] || management_url_default=false
    management_url="${a:-$management_url}"
    ops_python -c 'import sys; from chronicle_ops.setup_env import add_management_origin; add_management_origin("", {}, sys.argv[1])' \
      "$management_url" || die "researcher URL must be an HTTPS origin"
    ops_python reconcile preflight || die "reconciliation prerequisites failed before publishing settings"
  fi
  source ./network-policy.sh
  validate_dashboard_networks "$researcher_sources" || die "invalid researcher source CIDRs"
  validate_dashboard_networks "$trusted_proxies" || die "invalid trusted proxy CIDRs"
  [[ -z "$pool_sources" ]] || validate_dashboard_networks "$pool_sources" || die "invalid pool ingress CIDRs"

  return 0
}

setup_dashboard_access() {
  # Internal dashboards require explicit password entry through dashboard-login.
  testing_login=false
  require_mfa=true
  [[ "$exposure" == internal ]] && require_mfa=false

  hash_pw() {
    local image
    image="${CADDY_SETUP_HASH_IMAGE:-$(sed -n 's/^CADDY_IMAGE=//p' .env.example | sed -n 1p)}"
    case "$image" in
      ""|__CHRONICLE_*)
        # Source-checkout fallback. Published bundles use their own digest-pinned Caddy
        # release image above, so setup never depends on a mutable tag.
        image='caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d'
        ;;
    esac
    docker run --rm -i --network none --read-only --entrypoint caddy \
      "$image" hash-password | tr -d '\r\n'
  }

  dash_pw="" dash_pw_confirm="" dash_hash="$keep_dash_hash"
  dashboard_password_hash_generated=false
  if [[ "$exposure" == internal ]]; then
    if [[ -z "$dash_hash" ]]; then
      printf '\nChoose the dashboard password (at least 16 characters). It is read silently,\n'
      printf 'sent to Caddy over stdin, and never stored or printed by this script.\n'
      read -rsp "Dashboard password: " dash_pw; printf '\n'
      read -rsp "Confirm dashboard password: " dash_pw_confirm; printf '\n'
      [[ "$dash_pw" == "$dash_pw_confirm" ]] || die "dashboard passwords do not match"
      [[ ${#dash_pw} -ge 16 ]] || die "dashboard password must be at least 16 characters"
      printf 'Hashing the dashboard password...\n'
      dash_hash=$(printf '%s\n' "$dash_pw" | hash_pw)
      dashboard_password_hash_generated=true
      dash_pw=""; dash_pw_confirm=""
    fi
    [[ "$dash_hash" == \$2* ]] || die "could not bcrypt-hash the dashboard password (is docker working?)"
  fi

  return 0
}

# Reads a yes/no answer the way people type one: y, yes, n or no, in any case, with spaces
# trimmed. Sets YES_NO_ANSWER to yes or no; returns 1 for anything else (RD-N1: "no" used to
# enable monitoring because only a bare n counted as no).
yes_no_answer() {
  local answer="$1"
  answer="${answer#"${answer%%[![:space:]]*}"}"
  answer="${answer%"${answer##*[![:space:]]}"}"
  # Patterns, not ${1,,}: macOS ships bash 3.2.
  case "$answer" in
    [Yy]|[Yy][Ee][Ss]) YES_NO_ANSWER=yes ;;
    [Nn]|[Nn][Oo]) YES_NO_ANSWER=no ;;
    *) YES_NO_ANSWER=""; return 1 ;;
  esac
}

setup_monitoring() {
  # The mode is written as the COMPOSE_FILE line, not as two settings a later
  # `docker compose up -d` would ignore. This is the same string .env.example ships; setup
  # only swaps in the mode overlay the answers above chose.
  mode_file="overlays/mode-${tls_mode}-${exposure}.yml"
  [[ "$tls_mode" == local-https ]] && mode_file="overlays/mode-local-https.yml"
  compose_file="docker-compose.yml:${mode_file}:overlays/backups.yml"
  monitoring_enabled=false grafana_bind="${GRAFANA_BIND:-127.0.0.1}" metrics_retention="${METRICS_RETENTION:-30d}" logs_retention="${LOGS_RETENTION:-14d}"
  monitoring_default=$(ops_python host-memory monitoring-default) || die "could not check host memory"
  if [[ -n "$env_snapshot" ]]; then
    monitoring_default=N
    [[ "${COMPOSE_FILE:-}" != *overlays/monitoring.yml* ]] || monitoring_default=Y
  fi
  printf '\nEnable private Grafana monitoring with metrics and sanitized logs? [%s] ' "$monitoring_default"
  read -r monitoring_answer
  monitoring_answer="${monitoring_answer:-$monitoring_default}"
  yes_no_answer "$monitoring_answer" ||
    die "unrecognised answer '$monitoring_answer' to the monitoring question; answer yes or no"
  if [[ "$YES_NO_ANSWER" == no ]]; then
    monitoring_enabled=false
  else
    monitoring_enabled=true
    compose_file+=":overlays/monitoring.yml"
    printf 'Which private address should Grafana listen on?\n'
    printf '  Use 127.0.0.1 for an SSH tunnel, or a VPN/management address for viewers.\n'
    grafana_bind=$(ask_bind_addr "${GRAFANA_BIND:-$internal_bind}")
    read -rp "Metrics retention [$metrics_retention]: " metrics_answer
    metrics_retention="${metrics_answer:-$metrics_retention}"
    [[ "$metrics_retention" =~ ^[1-9][0-9]*d$ ]] || die "metrics retention must be whole days, for example 30d"
    read -rp "Sanitized log retention [$logs_retention]: " logs_answer
    logs_retention="${logs_answer:-$logs_retention}"
    [[ "$logs_retention" =~ ^[1-9][0-9]*d$ ]] || die "log retention must be whole days, for example 14d"
    printf 'Optional HTTPS alert webhook (blank preserves an existing destination).\n'
    # Refused here, before anything is written: off this host it must be HTTPS (guard-config.sh).
    while :; do
      alert_webhook=""
      read -rsp 'Webhook URL: ' alert_webhook || true; printf '\n'
      if [[ -z "$alert_webhook" ]] || bash ./guard-config.sh --validate-alert-webhook "$alert_webhook"; then break; fi
      printf 'The alert webhook must be HTTPS (plain HTTP only to this host'"'"'s loopback), with no credentials,\n' >&2
      printf 'quotes or spaces. It was not saved; enter it again, or leave it blank.\n' >&2
    done
    keep_alert_webhook="${alert_webhook:-$keep_alert_webhook}"
  fi

  return 0
}

setup_backup_retention() {
  # Backups are pruned only as the operator answers here. Suggestions are the backup image's
  # own defaults (selfhost/Dockerfile.backup, from prodrigestivill/postgres-backup-local); the
  # safety dumps have no upstream default, so they get none. A piped setup gets no suggestion:
  # it must answer, or keep a value an earlier setup saved. "all" never prunes that tier.
  local key label suggestion answer
  printf '\n%s\n' $"How long should database backups be kept? Answer a number, or \"all\" to never delete them."
  # The image prunes with find -mtime +0 (daily) and +1 (weekly, monthly), so 0 is not "no limit".
  printf '%s\n' $"0 keeps only the newest backup of that kind."
  for key in BACKUP_KEEP_DAYS BACKUP_KEEP_WEEKS BACKUP_KEEP_MONTHS PRE_OP_BACKUP_KEEP_DAYS; do
    case "$key" in
      BACKUP_KEEP_DAYS) label="Daily backups, in days" suggestion=7 ;;
      BACKUP_KEEP_WEEKS) label="Weekly backups, in weeks" suggestion=4 ;;
      BACKUP_KEEP_MONTHS) label="Monthly backups, in months" suggestion=6 ;;
      PRE_OP_BACKUP_KEEP_DAYS) label="Safety dumps taken before an update or restore, in days" suggestion="" ;;
    esac
    [[ -t 0 ]] || suggestion=""
    if [[ -n "${!key:-}" ]]; then
      suggestion="${!key}"
      label+=" [$suggestion, kept from the current settings]"
    elif [[ -n "$suggestion" ]]; then
      label+=" [$suggestion, the backup image default]"
    fi
    read -rp "${label}: " answer || true
    answer="${answer:-$suggestion}"
    [[ -n "$answer" ]] || die "${key} needs an answer: a number, or all to never delete"
    if [[ "$key" == PRE_OP_BACKUP_KEEP_DAYS ]]; then
      [[ "$answer" == all || "$answer" =~ ^[1-9][0-9]{0,3}$ ]] || die "${key} must be all or 1 to 9999 days"
    else
      [[ "$answer" == all || "$answer" =~ ^(0|[1-9][0-9]{0,8})$ ]] || die "${key} must be all or a whole number"
    fi
    printf -v "retention_${key}" '%s' "$answer"
  done
  return 0
}

setup_project() {
  # Compose keys volumes off the project name, so a second deployment that keeps the
  # default would recreate the first one's containers and mount its database. `up` already
  # refuses that, but refusing at `up` is too late to be useful: every question has been
  # answered by then. Settle it here, while the operator is still being asked things.
  project="${keep_project:-${COMPOSE_PROJECT_NAME:-chronicle-selfhost}}"
  [[ "$project" =~ ^[a-z0-9][a-z0-9_-]*$ ]] ||
    die "a deployment name must be lowercase letters, digits, dashes or underscores"
  foreign=$(foreign_project "$project") || return 1
  if [[ -n "$foreign" ]]; then
    # Numbered rather than named after the directory: a clone usually sits in one called
    # `chronicle`, and `chronicle` is the production deployment's own project name -- the
    # one name that must never be suggested, because Compose would mount its database.
    n=2
    suggested="${project}-2"
    foreign=$(foreign_project "$suggested") || return 1
    while [[ -n "$foreign" ]]; do
      n=$((n + 1)); suggested="${project}-${n}"
      foreign=$(foreign_project "$suggested") || return 1
    done
    printf '\n%sAnother Chronicle deployment named %s already exists on this host.%s\n' \
      "$YEL" "$project" "$RST"
    printf 'Docker keeps each deployment'\''s database under its project name, so this one\n'
    printf 'needs a name of its own or it would take over the other.\n'
    read -rp "Name for this deployment [${suggested}]: " project
    project="${project:-$suggested}"
    [[ "$project" =~ ^[a-z0-9][a-z0-9_-]*$ ]] ||
      die "a deployment name must be lowercase letters, digits, dashes or underscores"
    foreign=$(foreign_project "$project") || return 1
    [[ -z "$foreign" ]] ||
      die "'$project' is also taken by another deployment — choose a name nothing else uses"
  fi

  return 0
}

setup_network_and_credentials() {
  # Never move an existing deployment's network during setup, even if it now overlaps.
  default_subnet=$(ops_python -c 'from chronicle_ops.envfile import read_env, value; print(value(read_env(".env.example"), "CHRONICLE_SUBNET"))')
  subnet="${keep_subnet:-$default_subnet}"
  if [[ -z "$env_snapshot" ]]; then
    subnet=$(python3 ./network-subnet.py select "$default_subnet" "$project") ||
      die "could not select a free CHRONICLE_SUBNET"
    [[ "$subnet" == "$default_subnet" ]] ||
      printf 'Docker network range %s is free; using that for CHRONICLE_SUBNET.\n' "$subnet"
  fi

  # The internal core network (web, backend, PostgreSQL, backups) gets its own free /24, kept once chosen.
  core_prefix="${keep_core_prefix:-}"
  [[ -n "$core_prefix" ]] || core_prefix=$(python3 ./network-subnet.py select-core "$subnet" "$project") ||
    die "could not select a free subnet for the internal core network"

  gateway=$(ops_python -c 'import sys; from chronicle_ops.common import compose_gateway; print(compose_gateway(sys.argv[1]))' "$subnet") || die "invalid Compose subnet"
  [[ "$researcher_sources" != "$researcher_sources_default" ]] || researcher_sources="$gateway/32 127.0.0.1/32 ::1/128"
  if [[ "$tls_mode" == behind-proxy && "$http_bind" == 127.* &&
        "$trusted_proxies" == "$trusted_proxies_default" && -z "${CADDY_TRUSTED_PROXIES:-}" ]]; then
    trusted_proxies=$(trusted_proxy_sources "$tls_mode" "$http_bind" "$gateway" "")
  fi
  [[ "$pool_sources" != "$trusted_proxies_default" ]] || pool_sources="$trusted_proxies"

  return 0
}

setup_ports() {
  local_https_port=443 local_http_port=80
  want_http="${keep_http_port:-${HTTP_PORT:-8080}}" want_internal="${keep_internal_port:-${INTERNAL_PORT:-8081}}"
  if [[ "$tls_mode" == behind-proxy ]]; then
    http_port="$pool_port"
    if ! owns_listener "$project" "$WEB_PORT_OWNERS" "$http_bind" "$http_port" &&
        [[ "$(free_port "$http_port" "$http_bind")" != "$http_port" ]]; then
      die "LB pool endpoint $http_bind:$http_port is occupied; change the LB and setup together"
    fi
  else
    http_port=$(setup_port "$project" "$WEB_PORT_OWNERS" "$keep_http_port" "${HTTP_PORT:-8080}" "$http_bind") || die "no free public port"
  fi
  internal_port=$(setup_port "$project" "$WEB_PORT_OWNERS" "$keep_internal_port" "${INTERNAL_PORT:-8081}" \
    "$internal_bind" "$http_port") ||
    die "no free internal listener port was found near ${want_internal}"
  if [[ "$management_url_default" == true ]]; then
    resolved_management_host="$internal_bind"
    [[ "$resolved_management_host" != *:* ]] || resolved_management_host="[$resolved_management_host]"
    management_url="https://$resolved_management_host:$internal_port"
  fi
  [[ "$http_port" == "$want_http" && "$internal_port" == "$want_internal" ]] ||
    printf '\nPorts %s and %s are free on this host; using those.\n' "$http_port" "$internal_port"
  grafana_port="${GRAFANA_PORT:-3000}"
  if [[ "$monitoring_enabled" == true ]]; then
    grafana_port=$(setup_port "$project" "$GRAFANA_PORT_OWNERS" "$keep_grafana_port" "${GRAFANA_PORT:-3000}" \
      "$grafana_bind" "$http_port") ||
      die "no free Grafana port was found near ${GRAFANA_PORT:-3000}"
    [[ "$grafana_port" != "$internal_port" ]] ||
      grafana_port=$(free_port "$((internal_port + 1))" "$grafana_bind" "$http_port") ||
      die "no free Grafana port was found near ${GRAFANA_PORT:-3000}"
    [[ "$grafana_port" == "${GRAFANA_PORT:-3000}" ]] ||
      printf 'Grafana port %s is free on this host; using that.\n' "$grafana_port"
  fi

  if [[ "$tls_mode" == local-https ]]; then
    # A VPN or management service may legitimately own :443 on one of this host's other
    # interfaces. Docker Desktop cannot safely publish another wildcard :443 in that case,
    # so select the first free host ports and make the canonical app URL explicit.
    local_https_port=$(setup_port "$project" "$WEB_PORT_OWNERS" "$keep_local_https_port" 443 0.0.0.0) ||
      die "no free trial HTTPS port was found between 443 and 542"
    local_http_port=$(setup_port "$project" "$WEB_PORT_OWNERS" "$keep_local_http_port" 80 0.0.0.0 "$local_https_port") ||
      die "no free trial CA/redirect port was found between 80 and 179"
    if [[ "$local_https_port" == 443 ]]; then
      keep_public_base_url="https://${domain}"
    else
      keep_public_base_url="https://${domain}:${local_https_port}"
    fi
    [[ "$local_https_port" == 443 && "$local_http_port" == 80 ]] ||
      printf 'Trial HTTPS/CA ports %s and %s are free; using those.\n' \
        "$local_https_port" "$local_http_port"
  fi

  return 0
}

setup_lock_settings() {
  # The prompts above can wait indefinitely. Recheck right before publishing, holding the shared
  # operation lock through the write: rotation, restore and update take the same lock, so none
  # can change .env between this check and the write. The lock is released when the process
  # ends, however it ends, so an interrupted setup leaves nothing behind to clear.
  STATE_ROOT="$setup_state_root"
  lock_operation
  [[ -z "$env_snapshot" ]] || ops_python owner-check || die "setup must run from the active selfhost directory"
  assert_no_incomplete_mutation "run setup"
  if [[ -n "$env_snapshot" ]] && ! cmp -s .env "$env_snapshot" ||
      [[ -z "$env_snapshot" && -e .env ]]; then
    die ".env changed while setup was running (for example a secret rotation); setup did not overwrite it. Rerun ./chronicle setup."
  fi
  return 0
}

setup_guidance() {
  if [[ "$tls_mode" != local-https && "$(uname -s)" == Linux ]]; then
    need_env
    ops_python reconcile || die "could not install the operator boot/periodic reconciliation schedule"
  fi

  credentials_preserved=false credentials_generated=false
  for credential_value in "$keep_pg" "$keep_pg_app" "$keep_jwt" "$keep_metrics" "$keep_internal" "$keep_grafana"; do
    if [[ -n "$credential_value" ]]; then
      credentials_preserved=true
    else
      credentials_generated=true
    fi
  done
  if [[ -n "$keep_dash_hash" ||
        -n "$keep_reviewer_secret" ]]; then
    credentials_preserved=true
  fi
  if [[ "$dashboard_password_hash_generated" == true ]]; then
    credentials_generated=true
  elif [[ "$exposure" == internal && -n "$dash_hash" ]]; then
    credentials_preserved=true
  fi

  if [[ "$credentials_preserved" == true && "$credentials_generated" == true ]]; then
    credential_message='existing secrets preserved where valid; missing credentials generated'
  elif [[ "$credentials_preserved" == true ]]; then
    credential_message='existing secrets preserved, no credentials generated'
  else
    credential_message='secrets generated'
  fi
  printf '\n%sWrote .env%s (%s, mode 600)\n\n' "$GRN" "$RST" "$credential_message"
  if [[ "$exposure" == internal ]]; then
    printf '%sDashboard login:%s %s\n' "$BLD" "$RST" $"use the shared dashboard password you just chose."
    printf '  Only its bcrypt hash is stored, so the cleartext cannot be recovered here.\n\n'
  fi
  if [[ "$monitoring_enabled" == true ]]; then
    printf '%sMonitoring:%s Grafana will listen on https://%s:%s with %s metrics and %s sanitized logs.\n' \
      "$BLD" "$RST" "$grafana_bind" "$grafana_port" "$metrics_retention" "$logs_retention"
    printf '  After startup: ./chronicle monitoring add-viewer NAME\n\n'
    if [[ -n "$keep_alert_webhook" ]]; then
      printf '  Alert destination saved. Send a Grafana contact-point test and confirm receipt before relying on delivery.\n'
    else
      printf '  No alert webhook: scheduled reconciliation writes firing alerts to the host system log (journalctl -t chronicle).\n'
      printf '  Set CHRONICLE_ALERT_WEBHOOK_URL to also send them to a person.\n'
    fi
    printf '  See selfhost/docs/MONITORING-RUNBOOK.md, “Where alerts go.”\n\n'
  fi

  effective_public_base_url="${keep_public_base_url:-https://${domain}}"
  printf 'Public mobile enrollment:\n'
  printf '  server URL: %s\n' "$effective_public_base_url"
  printf '  Issue a one-time enrollment link from the dashboard. The public app exchanges it\n'
  printf '  for a per-device API key; no deployment-wide secret is copied into the app.\n'

  [[ "$tls_mode" == own-tls ]] && printf '%sPut cert.pem and key.pem in ./tls before starting.%s\n\n' "$YEL" "$RST"
  if [[ "$tls_mode" == local-https ]]; then
    printf '%sThis is a trial setup.%s The certificate will be signed by a CA that exists\n' "$YEL" "$RST"
    printf 'only inside this stack, so each test phone has to install it first. After\n'
    printf 'starting, scan the QR code printed by ./chronicle up.\n\n'
    printf 'Do not ask study participants to install it — for a real study, re-run setup\n'
    printf 'and choose option 1 or 2.\n\n'
  fi
  printf 'Next:  ./chronicle up\n'
  # Re-read the generated state directory and release version before the receipt is written.
  need_env
  operation_succeeded
  return 0
}

