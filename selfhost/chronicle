print_help() { awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$SCRIPT_PATH"; }

print_command_help() {
  case "$1" in
    setup) printf '%s\n' 'usage: ./chronicle setup' ;;
    up) printf '%s\n' 'usage: ./chronicle up [--no-reconcile]' ;;
    check) printf '%s\n' 'usage: ./chronicle check' ;;
    backup) printf '%s\n' 'usage: ./chronicle backup' ;;
    verify) printf '%s\n' 'usage: ./chronicle verify [--dashboard-password]' ;;
    status) printf '%s\n' 'usage: ./chronicle status' ;;
    doctor) printf '%s\n' 'usage: ./chronicle doctor [--json]' ;;
    monitoring) printf '%s\n' 'usage: ./chronicle monitoring status|add-viewer|remove-viewer|reset-viewer [name]' ;;
    logs) printf '%s\n' 'usage: ./chronicle logs [SERVICE ...]' ;;
    down) printf '%s\n' 'usage: ./chronicle down' ;;
    reconcile) printf '%s\n' 'usage: ./chronicle reconcile stop|uninstall' ;;
    rollback) printf '%s\n' 'usage: ./chronicle rollback --from OLD_DIR --trusted-sha256 SHA [--yes] DUMP' ;;
    cleanup) printf '%s\n' 'usage: ./chronicle cleanup --releases-dir DIR [--apply]' ;;
    restore) printf '%s\n' 'usage: ./chronicle restore [--yes] [--no-start] --trusted-sha256=SHA256 [DUMP]' \
      '       ./chronicle restore --recover [--yes] [--no-start]' ;;
    deletion-status) printf '%s\n' 'usage: ./chronicle deletion-status STUDY_UUID [OPERATION_UUID]' ;;
    update) printf '%s\n' 'usage: ./chronicle update [VERSION] [--check]' ;;
    rotate-secret) printf '%s\n' 'usage: ./chronicle rotate-secret [--yes] dashboard|jwt|internal-web|reviewer|metrics|postgres|postgres-app|grafana|tde' \
      '       ./chronicle rotate-secret [--yes] jwt --revoke-sessions' \
      '       ./chronicle rotate-secret recover --forward|--rollback [--yes]' ;;
    *) return 2 ;;
  esac
}

command_usage_error() {
  local command="$1" detail="${2:-invalid arguments}"
  printf '%s\n' "${RED}error:${RST} ${detail}" >&2
  print_command_help "$command" >&2 || true
  exit 2
}

validate_command_arguments() {
  local command="$1" argument
  shift
  case "$command" in
    setup|check|status|down|backup)
      (($# == 0)) || command_usage_error "$command" "${command} does not accept arguments" ;;
    up)
      (($# == 0)) || [[ $# == 1 && "$1" == --no-reconcile ]] ||
        command_usage_error "$command" "invalid up option" ;;
    verify)
      (($# == 0)) || [[ $# == 1 && "$1" == --dashboard-password ]] ||
        command_usage_error "$command" "invalid verify option" ;;
    doctor)
      (($# == 0)) || [[ $# == 1 && "$1" == --json ]] ||
        command_usage_error "$command" "invalid doctor option" ;;
    monitoring)
      case "${1:-}" in
        status) (($# == 1)) || command_usage_error "$command" "monitoring status takes no arguments" ;;
        add-viewer|remove-viewer|reset-viewer)
          (($# == 2)) || command_usage_error "$command" "monitoring viewer actions require one name"
          [[ "$2" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] ||
            command_usage_error "$command" "invalid monitoring viewer name" ;;
        *) command_usage_error "$command" "invalid monitoring action" ;;
      esac ;;
    logs)
      for argument in "$@"; do
        [[ "$argument" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] ||
          command_usage_error "$command" "invalid log service name or option: $argument"
      done ;;
    restore|rollback|cleanup|update)
      local parse_error
      parse_error="$(ops_python -c 'import sys; from chronicle_ops.__main__ import argument_parser; argument_parser().parse_args(sys.argv[1:])' "$command" "$@" 2>&1 >/dev/null)" ||
        command_usage_error "$command" "${parse_error##*error: }" ;;
    deletion-status)
      local uuid_pattern='^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$'
      [[ $# -ge 1 && $# -le 2 && "$1" =~ $uuid_pattern ]] ||
        command_usage_error "$command" "invalid study UUID or argument count"
      [[ $# == 1 || "$2" =~ $uuid_pattern ]] ||
        command_usage_error "$command" "invalid operation UUID" ;;
    reconcile)
      [[ $# == 1 && ( "$1" == stop || "$1" == uninstall ) ]] || command_usage_error "$command" "expected stop or uninstall" ;;
    rotate-secret) bash ./rotate-secret.sh --validate "$@" >/dev/null || command_usage_error "$command" ;;
    *)
      printf '%s\n\n' "${RED}error:${RST} unknown command '$command'" >&2
      print_help >&2
      exit 2 ;;
  esac
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0

(($#)) || set -- help
command="$1"
if [[ "$command" == help || "$command" == -h || "$command" == --help ]]; then
  (($# <= 2)) || { printf '%s\n' 'usage: ./chronicle help [COMMAND]' >&2; exit 2; }
  if (($# == 2)); then
    print_command_help "$2" || command_usage_error "$2" "unknown command: $2"
  else
    print_help
  fi
  exit 0
fi
if [[ $# -ge 2 && ( "$2" == -h || "$2" == --help ) ]]; then
  [[ $# == 2 ]] || command_usage_error "$command" "help does not accept additional arguments"
  print_command_help "$command" || command_usage_error "$command" "unknown command: $command"
  exit 0
fi
validate_command_arguments "$@"

case "$command" in
  setup)  cmd_setup "$@" ;;
  up)     cmd_up "$@" ;;
  check)  cmd_check "$@" ;;
  verify) cmd_verify "$@" ;;
  status) cmd_status "$@" ;;
  doctor) cmd_doctor "$@" ;;
  monitoring) cmd_monitoring "$@" ;;
  logs)   cmd_logs "$@" ;;
  down)   cmd_down "$@" ;;
  reconcile) cmd_reconcile "$@" ;;
  restore) cmd_restore "$@" ;;
  backup) cmd_backup "$@" ;;
  rollback) shift; need_env; ops_python rollback "$@" ;;
  cleanup) shift; need_env; ops_python cleanup "$@" ;;
  deletion-status) cmd_deletion_status "$@" ;;
  update) cmd_update "$@" ;;
  rotate-secret) cmd_rotate_secret "$@" ;;
esac
