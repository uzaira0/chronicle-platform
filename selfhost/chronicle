# What `status` adds below the service table: configuration drift (PR-O13). Informational; it
# never changes the exit status.
status_notes() {
  local row state summary action
  row="$(ops_python config-drift 2>/dev/null)" || return 0
  IFS=$'\x1f' read -r _ state summary action <<<"$row"
  if [[ "$state" == warn ]]; then
    printf '\n%swarn%s %s\n       action: %s\n' "$YEL" "$RST" "$summary" "$action"
  fi
  # Firing alerts (chronicle_ops/alerts.py); nothing when monitoring is off.
  row="$(ops_python alerts 2>/dev/null)" || return 0
  [[ -n "$row" ]] || return 0
  IFS=$'\x1f' read -r _ state summary action <<<"$row"
  if [[ "$state" == warn ]]; then
    printf '\n%swarn%s %s\n       action: %s\n' "$YEL" "$RST" "$summary" "$action"
  fi
  return 0
}
cmd_logs()   { need_env; shift || true; dc logs -f --tail=100 "$@"; }
cmd_down() {
