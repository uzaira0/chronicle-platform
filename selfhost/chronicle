  shift || true
  local signing_fingerprint keep_pg keep_pg_app keep_jwt keep_metrics
  local keep_internal keep_public_base_url keep_alert_webhook keep_reviewer_enabled
  local keep_reviewer_secret keep_reviewer_study keep_reviewer_participant keep_grafana keep_dash_hash keep_state
  local keep_http_port keep_internal_port keep_grafana_port keep_project keep_local_https_port keep_local_http_port
  local keep_subnet keep_core_prefix core_prefix setup_state_root env_snapshot mode_default previous_mode tls_mode
  local domain http_bind exposure internal_bind suggested initial_subnet
  local gateway researcher_sources_default trusted_proxies_default public_origin trusted_proxies pool_sources
  local pool_port public_http researcher_sources management_url management_url_default lb_body
  local lb_idle lb_headers management_host testing_login require_mfa
  local dash_pw dash_pw_confirm dash_hash dashboard_password_hash_generated
  local mode_file compose_file monitoring_enabled grafana_bind metrics_retention
  local logs_retention monitoring_default alert_webhook project foreign
  local n default_subnet subnet retention_BACKUP_KEEP_DAYS retention_BACKUP_KEEP_WEEKS
  local retention_BACKUP_KEEP_MONTHS retention_PRE_OP_BACKUP_KEEP_DAYS
  local http_port internal_port local_https_port local_http_port want_http want_internal
  local resolved_management_host grafana_port credentials_preserved credentials_generated credential_value
  local effective_public_base_url setup_outcome
  # A fresh install refuses a daemon the release images cannot run on; re-setup of a running
  # deployment only warns.
  if [[ -f .env ]]; then preflight_architecture up; else preflight_architecture setup; fi
  setup_existing_settings
  [[ "$setup_outcome" != kept ]] || return 0
  local phase
  for phase in setup_mode_and_domain setup_network_policy setup_dashboard_access \
      setup_monitoring setup_backup_retention setup_project setup_network_and_credentials \
      setup_ports; do
    "$phase" || return $?
  done
  setup_lock_settings || return $?
  setup_write_environment
  need_env
  ops_python setup-storage || die "storage encryption needs confirmation or a reviewed waiver; rerun setup"
  chmod 600 .env
  ops_python backup-footprint || die "could not estimate backup disk use"

  setup_guidance

}

# ------------------------------------------------------------------------------ images
# A published release bundle carries digest-pinned images and simply pulls them. A source
# checkout carries Dockerfiles and no images at all, and `.env` inherits the release
# placeholders from `.env.example` -- which compose rejects with "invalid reference format:
# repository name must be lowercase", naming neither the cause nor the cure. Building them
# here is what makes `clone -> setup -> up` work in a source tree, which is the path the
# README documents and the one every first-time operator takes.
is_source_checkout() {
  [[ -f ../docker/Dockerfile.backend && -f Dockerfile.frontend && -f Dockerfile.caddy ]]
}

# A source checkout keeps the server and dashboard code in git submodules, and a plain
# `git clone` leaves those directories empty. The backend image copies
# `chronicle-server/build.gradle` and four siblings, so an uninitialised checkout fails
# inside Docker with "COPY failed: file not found" naming a path that plainly exists in the
# repository -- which reads as a broken build rather than a missing checkout step.
# chronicle (Android) and chronicle-ios are deliberately absent: neither is part of the
# server build, and chronicle-ios is pinned `update = none`.
SOURCE_SUBMODULES=(chronicle-models chronicle-api chronicle-server rhizome rhizome-client chronicle-web)

ensure_sources() {
  local missing=() m
  for m in "${SOURCE_SUBMODULES[@]}"; do
    [[ -e "../$m/build.gradle" || -e "../$m/package.json" ]] || missing+=("$m")
  done
  ((${#missing[@]})) || return 0
  git -C .. rev-parse --git-dir >/dev/null 2>&1 ||
    die "the source directories ${missing[*]} are empty and this is not a git checkout.
       Use a published release bundle, or clone the repository with its submodules."
  printf '  checking out source for %s — first run only\n' "${missing[*]}"
  git -C .. submodule update --init --recursive -- "${missing[@]}" >/dev/null ||
    die "could not check out the source submodules (${missing[*]}).
       Run this from the repository root and try again:  git submodule update --init"
  for m in "${missing[@]}"; do
    [[ -e "../$m/build.gradle" || -e "../$m/package.json" ]] ||
      die "submodule $m is still empty after checkout — the build cannot proceed"
  done
}

# Local tags for a source build. Deliberately not `latest`: a moving tag on a research
# deployment makes "which code is running?" unanswerable after the fact. The revision is
# part of the tag so a later git pull cannot silently keep running an image built from an
# older checkout.
source_checkout_revision() {
  local module line status revision
  git -C .. rev-parse --git-dir >/dev/null 2>&1 ||
    die "source images require a git checkout so their inputs can be identified"

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    status="${line:0:1}"
    case "$status" in
      ' ') ;;
      -) die "a required source submodule is not initialized. Run: git submodule update --init --recursive" ;;
      +) die "a source submodule does not match this checkout. Preserve any local work, then run: git submodule update --init --recursive" ;;
      U) die "a source submodule has an unresolved merge conflict; resolve it, then run git submodule update --init --recursive" ;;
      *) die "could not verify the source submodule state; run git submodule status and correct the reported error" ;;
    esac
  done < <(git -C .. submodule status --recursive -- "${SOURCE_SUBMODULES[@]}")

  # A commit-derived image tag is truthful only when every copied build input matches that
  # commit. Runtime state and .env are ignored by git and never enter the Docker context.
  if ! git -C .. diff --quiet --no-ext-diff HEAD -- \
      build.gradle.kts settings.gradle.kts gradle.properties gradle gradles gradlew \
      docker selfhost; then
    die "tracked source-image inputs have local changes. Commit them on an appropriate branch or restore them before building a deployable source image"
  fi
  if [[ -n "$(git -C .. ls-files --others --exclude-standard -- \
      build.gradle.kts settings.gradle.kts gradle.properties gradle gradles gradlew \
      docker selfhost)" ]]; then
    die "untracked source-image inputs are present. Review and commit or remove them before building a deployable source image"
  fi
  for module in "${SOURCE_SUBMODULES[@]}"; do
    git -C "../$module" diff --quiet --no-ext-diff &&
      git -C "../$module" diff --cached --quiet --no-ext-diff &&
      [[ -z "$(git -C "../$module" ls-files --others --exclude-standard)" ]] ||
      die "source submodule $module has local or untracked changes; refusing to label them as a published revision"
  done

  revision="$(git -C .. rev-parse --verify HEAD)"
  [[ "$revision" =~ ^[0-9a-f]{40}$ ]] || die "could not resolve the source revision; run git rev-parse HEAD in this checkout and correct the reported error"
  printf '%s\n' "$revision"
}

ensure_images() {
  if ! ops_python -c 'from chronicle_ops.images import requested_images; import sys; sys.exit(not any(image.managed() for image in requested_images(sys.argv[1])))' "${COMPOSE_FILE:-}"; then
    return 0
  fi
  is_source_checkout || die "source images require a source checkout; use a published release bundle"
  ensure_sources
  local source_revision
  source_revision="$(source_checkout_revision)" || exit 1
  ops_python -c 'from chronicle_ops.images import build_source_images; import sys; build_source_images(sys.argv[1], sys.argv[2])' "$source_revision" "${COMPOSE_FILE:-}" ||
    die "could not build and record source images; correct the first docker build error above, then rerun ./chronicle up"
  need_env
}

# ---------------------------------------------------------------------------------- up
# Start the configured services after host checks, then run the trial CA export separately.
assert_no_incomplete_mutation() {
  ops_python reconcile "${2:-check}" || die "cannot ${1:-start Chronicle}; follow the operation recovery runbook"
}

lock_operation() {
  local path
  path=$(ops_python reconcile lock-path) || die "could not resolve the operation lock; run ./chronicle doctor"
  if ops_python -c 'import sys; from chronicle_ops.common import holds_operation_lock; sys.exit(0 if holds_operation_lock(sys.argv[1]) else 1)' "$STATE_ROOT"; then
    return
  fi
  # Lock in place rather than re-running the command under the lock: a re-run replays setup's
  # prompts against stdin it already consumed. flock belongs to the open file, so the lock the
  # helper takes through fd 9 stays held by this shell. Fixed fd: macOS bash 3.2 has no {fd}.
  [[ ! -L "$path" ]] || die "operation lock $path is a symlink"
  exec 9<>"$path" || die "could not open the operation lock $path; make the state directory writable by this account, then retry"
  export CHRONICLE_OPERATION_LOCK_FD=9
  ops_python -c 'import sys; from chronicle_ops.common import acquire_operation_lock; sys.exit(acquire_operation_lock(sys.argv[1]) is not None)' \
    "$STATE_ROOT" || die "could not acquire the operation lock; run ./chronicle doctor to find the running operation"
}

cmd_up() {
  shift || true
  need_env
  if [[ "${1:-}" == --no-reconcile ]]; then
    export CHRONICLE_RECONCILE_ENABLED=false
  fi
  # A destructive restore can leave a deliberately stopped, partially replaced schema.
  # The preserved lock must be an enforced interlock, not merely a warning printed by the
  # failed restore process. Apply the same rule to failed upgrades and rotations: `up` is
  # the ordinary recovery shortcut operators will reach for after a failure, so it must not
  # bypass the state-changing command's fail-closed boundary (including dangling symlinks).
  begin_operation up startup_failed
  local locked_state="$STATE_ROOT" locked_project="$PROJECT"
  lock_operation
  need_env
  [[ "$STATE_ROOT" == "$locked_state" && "$PROJECT" == "$locked_project" ]] ||
    die "state directory or Compose project changed while acquiring the lock; retry startup"
  ops_python owner-check || die "startup must run from the active selfhost directory"
  if [[ "${CHRONICLE_RECONCILE_RUN:-false}" == true ]] &&
      { [[ "${CHRONICLE_RECONCILE_ENABLED:-true}" == false ]] || ops_python reconcile stopped; }; then
    # Paused or disabled reconciliation is a successful no-op, not a failed start (AF-P5).
    operation_succeeded
    return 0
  fi
  assert_no_incomplete_mutation "start Chronicle" check-start
  ensure_images
  preflight
  local certificate_after certificate_state
  if [[ "${COMPOSE_FILE:-}" == *overlays/monitoring.yml* ]]; then
    # Monitoring is optional: a failure here is reported, and Chronicle starts without it.
    dc run --rm --no-deps monitoring-cert-init || warn "monitoring certificate preparation failed; Chronicle starts without monitoring. Inspect the monitoring-cert-init error above; ./chronicle doctor reports monitoring"
  fi
  dc run --rm --no-deps cert-init || die "certificate preparation failed; correct the cert-init error above (files in ./tls), then rerun ./chronicle up"
  certificate_after=$(ops_python certificates digest) || die "could not read the prepared certificates; run ./chronicle doctor"
  certificate_state=$(printf '%s\n' "$certificate_after" | ops_python certificates compare) || die "could not compare the prepared certificates; run ./chronicle doctor"
  printf '%sStarting%s (%s)\n' "$BLD" "$RST" "${COMPOSE_FILE:-docker-compose.yml}"
  printf '  on a first run this also initialises the database — no output until it settles\n\n'
  # Compose's own progress stream prints one line per container per state transition: 34
  # lines for this stack, ten of them for the single config-guard that starts and exits.
  # It scrolls the preflight results off the screen and contains nothing an operator can
  # act on. The service table below is the same information, once, in its final form.
  # ca-export exits after it writes the local CA. Run it after the long-running services are
  # healthy, because Compose --wait treats an exited one-shot service as a startup failure.
  # Only core services gate startup. Optional monitoring (chronicle_ops/services.py decides which
  # services those are) starts afterwards with its own bounded wait and only warns.
  local configured_services monitoring_services service has_ca_export=false
  local -a startup_services=() startup_options=()
  if [[ "$certificate_state" == changed ]]; then
    # Renewed, not carried over: a recreated container gets its own anonymous volumes and the old
    # ones go with the old container (chronicle_ops/common.py FORCED_RECREATION).
    startup_options+=(--force-recreate --renew-anon-volumes)
  elif [[ "${CHRONICLE_RECONCILE_RUN:-false}" == true ]]; then
    startup_options+=(--no-recreate)
  fi
  if ! configured_services="$(dc config --services)"; then
    die "could not resolve the Compose service list; run docker compose config and correct the reported error"
  fi
  if ! monitoring_services="$(ops_python compose-services monitoring)"; then
    die "could not resolve the monitoring services; run docker compose config and correct the reported error"
  fi
  while IFS= read -r service; do
    [[ -n "$service" ]] || continue
    if grep -Fxq -- "$service" <<<"$monitoring_services"; then
      continue
    elif [[ "$service" == ca-export ]]; then
      has_ca_export=true
    else
      startup_services+=("$service")
    fi
  done <<<"$configured_services"
  ((${#startup_services[@]} > 0)) || die "Compose has no long-running services to start"
  if ! dc --progress quiet up -d --wait --wait-timeout "${START_WAIT_TIMEOUT_SECONDS:-3600}" --remove-orphans "${startup_options[@]}" "${startup_services[@]}"; then
    # Monitoring is independent of Chronicle's health so that it can explain this failure.
    ops_python start-monitoring "${startup_options[@]}"
    die "startup failed — see ./chronicle logs"
  fi
  ops_python start-monitoring "${startup_options[@]}"
  # Healthy services loaded these certificates. Record that now: a public origin that is not
  # reachable yet must not make every reconcile run recreate the stack.
  printf '%s\n' "$certificate_after" | ops_python certificates record || die "could not record the certificates applied at startup; make the state directory writable, then rerun ./chronicle up"
  if [[ "$has_ca_export" == true ]]; then
    dc run --rm --no-deps ca-export || die "local trial CA export failed; review the CA export error above"
  fi
  ops_python public-check || die "public HTTPS acceptance failed; resolve the failed check above"
  dc ps --format '{{.Service}}\t{{.Status}}' 2>/dev/null | sort | sed 's/^/  /'
  printf '\n%sStarted.%s Next: ./chronicle verify\n' "$GRN" "$RST"
  if [[ "${CHRONICLE_RECONCILE_RUN:-false}" != true && "${CHRONICLE_RECONCILE_ENABLED:-true}" == true ]]; then
    ops_python reconcile resume || die "could not resume periodic reconciliation; run ./chronicle doctor"
  fi
  operation_succeeded
}

