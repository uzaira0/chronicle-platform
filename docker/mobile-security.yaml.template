# Public clients use enrollment-issued per-device API keys.
enabled: false
signing-secret: ""
signing-required: false
max-request-age-minutes: 5
clock-skew-seconds: 30
nonce-ttl-minutes: 10
# Canonical public HTTPS root embedded in signed enrollment manifests.
public-base-url: "${CHRONICLE_PUBLIC_BASE_URL}"
# Proxy-injected secret authenticating the X-Chronicle-Internal-Web signing
# bypass (CWE-290 hardening). Traefik injects this same value on /chronicle/api/web.
# Blank => legacy "true" marker is honored for backward compatibility.
internal-web-secret: "${CHRONICLE_INTERNAL_WEB_SECRET}"
