enable-persistence: false
session-clustering-enabled: false

hazelcast:
  server: true
  group: "chronicle-prod"
  password: "${HAZELCAST_SERVER_PASSWORD}"
  cp-member-count: 0
  seed-nodes:
    - "localhost"
  port: 5710

hazelcast-clients:
  IDS:
    server: false
    group: "chronicle-prod"
    password: "${HAZELCAST_CLIENT_PASSWORD}"
    cp-member-count: 0
    seed-nodes:
      - "127.0.0.1:5710"

postgres:
  citus: false
  initialize-tables: false
  initialize-indices: false
  hikari:
    jdbcUrl: "jdbc:postgresql://postgres:5432/${POSTGRES_DB}?logServerErrorDetail=false&sslmode=verify-full&sslrootcert=/app/ssl/ca.crt"
    username: "chronicle_app"
    password: "${POSTGRES_APP_PASSWORD}"
    maximumPoolSize: 20
    minimumIdle: 5
    # Readiness has a 10s probe budget and then validates the connection for up
    # to 2s, so pool acquisition must fail before the probe itself times out.
    connectionTimeout: 5000
    idleTimeout: 600000
    maxLifetime: 1800000
    leakDetectionThreshold: 300000

datasources:
  chronicle:
    citus: false
    initialize-tables: false
    initialize-indices: false
    hikari:
      jdbcUrl: "jdbc:postgresql://postgres:5432/${POSTGRES_DB}?logServerErrorDetail=false&sslmode=verify-full&sslrootcert=/app/ssl/ca.crt"
      username: "chronicle_app"
      password: "${POSTGRES_APP_PASSWORD}"
      maximumPoolSize: 20
      minimumIdle: 5
      # Keep acquisition within the backend readiness probe budget.
      connectionTimeout: 5000
      idleTimeout: 600000
      maxLifetime: 1800000
      leakDetectionThreshold: 300000
