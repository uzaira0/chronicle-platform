  "ff16809942cc066a6facf1923f5f9970_0": {
    "author": "chronicle",
    "comment": "selfhost/chronicle_ops/update.py:546 False positive: os.execv replaces this process with the signature-verified candidate release's launcher and the fixed argv update --apply-from <the installed release directory>. The verified bundle must own signals and rollback traps; spawning a child breaks interruption recovery. No shell and no evaluation of strings.",
    "false_positive": true,
    "ignored_at": "2026-11-11T00:00:00Z"
  },
  "9a08db01ba6e1f8e1426bd83ae2dbe00_0": {
    "author": "chronicle",
    "comment": "Local CI runs the caller-selected argv directly through Popen without a shell. start_new_session isolates the command so timeout signals reach only the process group this wrapper created. CI command execution is the intended trust boundary.",
    "false_positive": true,
    "ignored_at": "2026-10-16T00:00:00Z"
  },
  "f187bd2327048228706883fbaa912501_0": {
