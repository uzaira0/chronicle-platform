# JDK dependency sandbox (scripts/deps-sandbox.sh --jdk): Gradle lock and verification-metadata
# regeneration, which executes the build's plugins, with no secrets. Same rules as Dockerfile.deps.
# JDK_IMAGE is docker/Dockerfile.backend's digest-pinned eclipse-temurin builder, passed in by
# deps-sandbox.sh so the two never drift; the default is the same image (deps-sandbox.sh refuses any
# other), the one scripts/os-package-pins.py resolves the pins below against. git is there because
# gradles/publish.gradle runs it, as the backend builder installs it, only at exact versions older than
# the dependency wait (selfhost/os-packages/apt-install-aged.sh from the os-packages build context).
ARG JDK_IMAGE=eclipse-temurin:25-jdk@sha256:2d5d5e9b533342a565907c84f47a2ec298c40cde7b13a3ca85d4950fa456a641
FROM ${JDK_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN --mount=type=bind,from=os-packages,source=apt-install-aged.sh,target=/usr/local/sbin/apt-install-aged.sh \
    sh /usr/local/sbin/apt-install-aged.sh ubuntu 20261106T000000Z \
      --add git \
      --pin git-man=1:2.53.0-1ubuntu1.1 git=1:2.53.0-1ubuntu1.1 libcurl3t64-gnutls=8.18.0-1ubuntu2.8 \
        liberror-perl=0.17030-1 libgdbm-compat4t64=1.26-1build1 libgdbm6t64=1.26-1build1 \
        libgnutls30t64=3.8.12-2ubuntu1.1 libgssapi-krb5-2=1.22.1-2ubuntu4.1 libhogweed6t64=3.10.2-1 \
        libidn2-0=2.3.8-4build1 libk5crypto3=1.22.1-2ubuntu4.1 libkeyutils1=1.6.3-6ubuntu3 \
        libkrb5-3=1.22.1-2ubuntu4.1 libkrb5support0=1.22.1-2ubuntu4.1 libldap-common=2.6.10+dfsg-1ubuntu5 \
        libldap2=2.6.10+dfsg-1ubuntu5 libnettle8t64=3.10.2-1 libnghttp2-14=1.68.0-2ubuntu0.2 \
        libperl5.40=5.40.1-7ubuntu0.3 libpsl5t64=0.21.2-1.1build2 librtmp1=2.4+20151223.gitfa8646d.1-3 \
        libsasl2-2=2.1.28+dfsg1-9ubuntu3 libsasl2-modules-db=2.1.28+dfsg1-9ubuntu3 \
        libssh2-1t64=1.11.1-1ubuntu0.26.04.4 libunistring5=1.3-2build1 perl-modules-5.40=5.40.1-7ubuntu0.3 \
        perl=5.40.1-7ubuntu0.3 && \
    mkdir -p /cache /home/sandbox && chown 1000:1000 /cache /home/sandbox

USER 1000:1000
WORKDIR /work
HEALTHCHECK NONE
