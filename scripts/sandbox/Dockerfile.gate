# Gate sandbox (scripts/deps-sandbox.sh --image gate): where the dependency gate runner runs the
# local-ci jobs that execute dependency or candidate code (verify-toolchain, every security job, web),
# with no secrets. Same rules as Dockerfile.deps: only the source tree is mounted, no host
# environment, no Docker socket or credentials, no SSH agent, no home directory, all capabilities
# dropped, and the network is none or the allowlisting egress proxy.
#
# JDK_IMAGE is docker/Dockerfile.backend's digest-pinned eclipse-temurin builder, passed in by
# deps-sandbox.sh so the two never drift (the default is the same image; deps-sandbox.sh refuses any
# other). OS packages enter only at exact versions older than the dependency wait
# (selfhost/os-packages/apt-install-aged.sh from the os-packages build context; scripts/os-package-pins.py
# refreshes the pins); bash, ca-certificates, coreutils, findutils, grep and util-linux
# are the base image's own. Bun is the toolchain-manifest.yaml pin (Renovate groups
# oven/bun as "bun runtime"). The release binaries are the versions the workstation runs, checked
# against the sha256 their projects publish. semgrep and ruff come from PyPI through uv with
# --exclude-newer seven days back, so nothing in their dependency trees is younger than the routine
# wait (docs/SUPPLY-CHAIN.md); semgrep is the toolchain-manifest.yaml pin.
# /gate-python (first on PATH) is the candidate's requirements-dev.txt, which the gate runner
# installs from hashes into a mounted directory before the other steps.
# The web job's browser tests launch Playwright's Chromium headless shell: the libraries after xz-utils
# are Playwright 1.64's debian13 list for Chromium, plus fontconfig and Liberation fonts for layout. The
# browser itself is the candidate's Playwright revision, installed by the gate runner's web step into
# /cache/ms-playwright (PLAYWRIGHT_BROWSERS_PATH, deps-sandbox.sh).
ARG JDK_IMAGE=eclipse-temurin:25-jdk@sha256:83f4a7fc27df94dcc7b8de04d14cbbba8da14406f921e966969c3b09000aa507
FROM ${JDK_IMAGE} AS jdk

FROM oven/bun:1.4.4-slim@sha256:1846adf22496bd711036aae8be147e57bdebbaea2e5264e3e0b5af1db187d9a4

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG TARGETARCH
ARG SEMGREP_VERSION
# Tool releases this image fetches. Renovate proposes each (custom manager in renovate.json, label
# manual-digests): the per-architecture sha256 values below are refreshed by hand with the tag, and until they
# are, sha256sum -c fails the build. yq is the same release as Dockerfile.deps (tests/quality/test_os_package_pins.py).
# renovate: datasource=pypi depName=ruff
ARG RUFF_VERSION=0.17.2
# renovate: datasource=github-releases depName=gitleaks/gitleaks
ARG GITLEAKS_TAG=v8.30.1
# renovate: datasource=github-releases depName=mikefarah/yq
ARG YQ_TAG=v4.54.1
# renovate: datasource=github-releases depName=koalaman/shellcheck
ARG SHELLCHECK_TAG=v0.11.0
# renovate: datasource=github-releases depName=astral-sh/uv
ARG UV_TAG=0.9.5

COPY --from=jdk /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk \
    PATH=/gate-python/bin:/opt/gate/venv/bin:/opt/gate/bin:/opt/java/openjdk/bin:/usr/local/bin:/usr/bin:/bin

RUN --mount=type=bind,from=os-packages,source=apt-install-aged.sh,target=/usr/local/sbin/apt-install-aged.sh \
    sh /usr/local/sbin/apt-install-aged.sh debian 20261108T000000Z \
      --add curl git jq python3 python3-venv python3-yaml ripgrep unzip xz-utils libasound2t64 \
        libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 libcairo2 libcups2t64 libdbus-1-3 libdrm2 \
        libgbm1 libglib2.0-0t64 libnspr4 libnss3 libpango-1.0-0 libx11-6 libxcb1 libxcomposite1 libxdamage1 \
        libxext6 libxfixes3 libxkbcommon0 libxrandr2 libfontconfig1 fonts-liberation \
      --pin at-spi2-common=2.56.2-1+deb13u2 curl=8.14.1-2+deb13u7 fontconfig-config=2.15.0-2.3 \
        fontconfig=2.15.0-2.3 fonts-liberation=1:2.1.5-3 git-man=1:2.47.3-0+deb13u1 git=1:2.47.3-0+deb13u1 \
        jq=1.7.1-6+deb13u4 libasound2-data=1.2.14-1+deb13u1 libasound2t64=1.2.14-1+deb13u1 \
        libatk-bridge2.0-0t64=2.56.2-1+deb13u2 libatk1.0-0t64=2.56.2-1+deb13u2 libatomic1=14.2.0-19 \
        libatspi2.0-0t64=2.56.2-1+deb13u2 libavahi-client3=0.8-16 libavahi-common-data=0.8-16 \
        libavahi-common3=0.8-16 libbrotli1=1.1.0-2+deb13u1 libcairo2=1.18.4-1+b1 libcom-err2=1.47.2-3+b12 \
        libcups2t64=2.4.10-3+deb13u2 libcurl3t64-gnutls=8.14.1-2+deb13u7 libcurl4t64=8.14.1-2+deb13u7 \
        libdatrie1=0.2.13-3+b1 libdbus-1-3=1.16.2-2 libdrm-amdgpu1=2.4.124-2 libdrm-common=2.4.124-2 \
        libdrm-intel1=2.4.124-2 libdrm2=2.4.124-2 libedit2=3.1-20250104-1 libelf1t64=0.192-4 \
        liberror-perl=0.17030-1 libexpat1=2.9.0-1~deb13u1 libffi8=3.4.8-2 libfontconfig1=2.15.0-2.3 \
        libfreetype6=2.13.3+dfsg-1+deb13u1 libfribidi0=1.0.16-1 libgbm1=25.0.7-2+deb13u1 \
        libgdbm-compat4t64=1.24-2 libgdbm6t64=1.24-2 libglib2.0-0t64=2.84.4-3~deb13u5 \
        libgnutls30t64=3.8.9-3+deb13u4 libgraphite2-3=1.3.14-2+deb13u1 libgssapi-krb5-2=1.21.3-5+deb13u1 \
        libharfbuzz0b=10.2.0-1+deb13u1 libidn2-0=2.3.8-2 libjq1=1.7.1-6+deb13u4 libk5crypto3=1.21.3-5+deb13u1 \
        libkeyutils1=1.6.3-6 libkrb5-3=1.21.3-5+deb13u1 libkrb5support0=1.21.3-5+deb13u1 \
        libldap2=2.6.10+dfsg-1 libllvm19=1:19.1.7-3+b1 libncursesw6=6.5+20250216-2 \
        libnghttp2-14=1.64.0-1.1+deb13u1 libnghttp3-9=1.8.0-1 libngtcp2-16=1.11.0-1+deb13u1 \
        libngtcp2-crypto-gnutls8=1.11.0-1+deb13u1 libnspr4=2:4.36-1 libnss3=2:3.110-1+deb13u4 \
        libonig5=6.9.9-1+b1 libp11-kit0=0.25.5-3 libpango-1.0-0=1.56.3-1 libpciaccess0=0.17-3+b3 \
        libperl5.40=5.40.1-6+deb13u1 libpixman-1-0=0.44.0-3 libpng16-16t64=1.6.48-1+deb13u6 \
        libpsl5t64=0.21.2-1.1+b1 libpython3-stdlib=3.13.5-1 libpython3.13-minimal=3.13.5-2+deb13u5 \
        libpython3.13-stdlib=3.13.5-2+deb13u5 libreadline8t64=8.2-6 librtmp1=2.4+20151223.gitfa8646d.1-2+b5 \
        libsasl2-2=2.1.28+dfsg1-9 libsasl2-modules-db=2.1.28+dfsg1-9 libsensors-config=1:3.6.2-2 \
        libsensors5=1:3.6.2-2 libssh2-1t64=1.11.1-1+deb13u2 libtasn1-6=4.20.0-2+deb13u1 libthai-data=0.1.29-2 \
        libthai0=0.1.29-2+b1 libunistring5=1.3-2 libwayland-server0=1.23.1-3 libx11-6=2:1.8.12-1 \
        libx11-data=2:1.8.12-1 libx11-xcb1=2:1.8.12-1 libxau6=1:1.0.11-1 libxcb-dri3-0=1.17.0-2+b1 \
        libxcb-present0=1.17.0-2+b1 libxcb-randr0=1.17.0-2+b1 libxcb-render0=1.17.0-2+b1 \
        libxcb-shm0=1.17.0-2+b1 libxcb-sync1=1.17.0-2+b1 libxcb-xfixes0=1.17.0-2+b1 libxcb1=1.17.0-2+b1 \
        libxcomposite1=1:0.4.6-1 libxdamage1=1:1.1.6-1+b2 libxdmcp6=1:1.1.5-1 libxext6=2:1.3.4-1+b3 \
        libxfixes3=1:6.0.0-2+b4 libxi6=2:1.8.2-1 libxkbcommon0=1.7.0-2 \
        libxml2=2.12.7+dfsg+really2.9.14-2.1+deb13u3 libxrandr2=2:1.5.4-1+b3 libxrender1=1:0.9.12-1 \
        libxshmfence1=1.3.3-1 libyaml-0-2=0.2.5-2 libz3-4=4.13.3-1 media-types=13.0.0 \
        mesa-libgallium=25.0.7-2+deb13u1 netbase=6.5 perl-modules-5.40=5.40.1-6+deb13u1 perl=5.40.1-6+deb13u1 \
        python3-minimal=3.13.5-1 python3-pip-whl=25.1.1+dfsg-1 python3-setuptools-whl=78.1.1-0.1 \
        python3-venv=3.13.5-1 python3-yaml=6.0.2-1+b2 python3.13-minimal=3.13.5-2+deb13u5 \
        python3.13-venv=3.13.5-2+deb13u5 python3.13=3.13.5-2+deb13u5 python3=3.13.5-1 readline-common=8.2-6 \
        ripgrep=14.1.1-1+b4 unzip=6.0-29+deb13u1 xkb-data=2.42-1 xz-utils=5.8.1-1+deb13u2

WORKDIR /tmp/gate
RUN set -eu; mkdir -p /opt/gate/bin; \
    case "$TARGETARCH" in \
      arm64) gl=arm64; yq=arm64; sc=aarch64; uv=aarch64; \
             gl_sum=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080; \
             yq_sum=189088da0c6429ec5178dfaab1a114805f6cab0b61b165ab236efedf1d57a71b; \
             sc_sum=12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588; \
             uv_sum=9db0c2f6683099f86bfeea47f4134e915f382512278de95b2a0e625957594ff3 ;; \
      amd64) gl=x64; yq=amd64; sc=x86_64; uv=x86_64; \
             gl_sum=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb; \
             yq_sum=8e34fc298390875de416e6a4afcb8cabeceb25d9aa8506c1a2f9353cf702ea5f; \
             sc_sum=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198; \
             uv_sum=2cf10babba653310606f8b49876cfb679928669e7ddaa1fb41fb00ce73e64f66 ;; \
      *) echo "unsupported TARGETARCH $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    fetch() { curl -fsSL --retry 5 --retry-all-errors --connect-timeout 20 --max-time 300 -o "$1" "$2"; \
              echo "$3  $1" | sha256sum -c -; }; \
    fetch gitleaks.tgz "https://github.com/gitleaks/gitleaks/releases/download/${GITLEAKS_TAG}/gitleaks_${GITLEAKS_TAG#v}_linux_${gl}.tar.gz" "$gl_sum"; \
    tar -xzf gitleaks.tgz -C /opt/gate/bin gitleaks; \
    fetch /opt/gate/bin/yq "https://github.com/mikefarah/yq/releases/download/${YQ_TAG}/yq_linux_${yq}" "$yq_sum"; \
    chmod 0755 /opt/gate/bin/yq; \
    fetch shellcheck.txz "https://github.com/koalaman/shellcheck/releases/download/${SHELLCHECK_TAG}/shellcheck-${SHELLCHECK_TAG}.linux.${sc}.tar.xz" "$sc_sum"; \
    tar -xJf shellcheck.txz --strip-components=1 -C /opt/gate/bin "shellcheck-${SHELLCHECK_TAG}/shellcheck"; \
    fetch uv.tgz "https://github.com/astral-sh/uv/releases/download/${UV_TAG}/uv-${uv}-unknown-linux-gnu.tar.gz" "$uv_sum"; \
    tar -xzf uv.tgz --strip-components=1 -C /opt/gate/bin "uv-${uv}-unknown-linux-gnu/uv"; \
    test -n "$SEMGREP_VERSION"; \
    UV_CACHE_DIR=/tmp/gate/uv /opt/gate/bin/uv venv --quiet --python /usr/bin/python3 --system-site-packages /opt/gate/venv; \
    UV_CACHE_DIR=/tmp/gate/uv /opt/gate/bin/uv pip install --quiet --python /opt/gate/venv/bin/python \
      --exclude-newer "$(date -u -d '7 days ago' +%Y-%m-%dT%H:%M:%SZ)" \
      "semgrep==${SEMGREP_VERSION}" "ruff==${RUFF_VERSION}"; \
    rm -rf /tmp/gate/*; \
    mkdir -p /cache /home/bun && chown bun:bun /cache /home/bun; \
    gitleaks version && yq --version && shellcheck --version && semgrep --version && ruff --version && java -version

USER bun
WORKDIR /work
HEALTHCHECK NONE
